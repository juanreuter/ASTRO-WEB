---
import "../styles/global.css";
import { company as companyEs, navigation as navigationEs } from "../data/site";
import { company as companyEn, navigation as navigationEn } from "../data/site.en";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  bodyClass?: string;
  lang?: "es" | "en";
  /** URL de la página equivalente en el otro idioma, para el hreflang y el selector ES/EN. */
  altLangHref?: string;
}

const {
  title,
  description,
  ogImage = "/images/trabajos/rack-testeo-equipo.jpg",
  bodyClass = "",
  lang = "es",
  altLangHref
} = Astro.props;

const company = lang === "en" ? companyEn : companyEs;
const navigation = lang === "en" ? navigationEn : navigationEs;

const uiText = {
  es: {
    navAriaLabel: "Navegación principal",
    openMenu: "Abrir menú",
    whatsappDirect: "WhatsApp directo",
    contact: "Contacto",
    requestQuote: "Solicitar presupuesto",
    footerHeading: "Infraestructura, seguridad y soporte con una sola estrategia.",
    footerCopy:
      "Trabajamos para que la confianza empiece antes del primer contacto. Diseñamos, implementamos y mantenemos soluciones tecnológicas respaldadas por experiencia real en campo.",
    close: "Cerrar",
    prev: "Anterior",
    next: "Siguiente",
    switchTo: "EN",
    switchAriaLabel: "Switch to English"
  },
  en: {
    navAriaLabel: "Main navigation",
    openMenu: "Open menu",
    whatsappDirect: "Direct WhatsApp",
    contact: "Contact",
    requestQuote: "Request a quote",
    footerHeading: "Infrastructure, security, and support under a single strategy.",
    footerCopy:
      "We work so that trust begins before the first contact. We design, implement, and maintain technology solutions backed by real field experience.",
    close: "Close",
    prev: "Previous",
    next: "Next",
    switchTo: "ES",
    switchAriaLabel: "Cambiar a español"
  }
} as const;
const t = uiText[lang];

const rawPathname = Astro.url.pathname;
// Normaliza la barra final: rutas estáticas prerenderizadas devuelven "/servicios/"
// pero navigation[].href está definido como "/servicios", sin barra.
const pathname = rawPathname !== "/" ? rawPathname.replace(/\/$/, "") : rawPathname;
const siteUrl = Astro.site ?? new URL("https://reuter.com.ar");
const canonicalUrl = new URL(rawPathname, siteUrl);
const ogImageUrl = new URL(ogImage, siteUrl);
const altLangUrl = altLangHref ? new URL(altLangHref, siteUrl) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl.toString()} />
    <link rel="icon" type="image/png" href="/images/favicon-reuter.png" />

    {altLangUrl && (
      <>
        <link rel="alternate" hreflang={lang} href={canonicalUrl.toString()} />
        <link rel="alternate" hreflang={lang === "es" ? "en" : "es"} href={altLangUrl.toString()} />
        <link rel="alternate" hreflang="x-default" href={(lang === "es" ? canonicalUrl : altLangUrl).toString()} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_AR"} />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:image" content={ogImageUrl.toString()} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.toString()} />

    <style>
      .lang-switch {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.2rem;
        min-width: 2.55rem;
        height: 2.55rem;
        padding: 0.3rem 0.5rem;
        border: 1px solid var(--line-strong);
        border-radius: var(--radius);
        text-decoration: none;
        transition: all 0.2s ease;
      }
      .lang-switch:hover {
        border-color: var(--line-bright);
        background: var(--bg-elev);
      }
      .lang-switch-flag {
        width: 1.35rem;
        height: auto;
        display: block;
        border-radius: 2px;
        box-shadow: 0 0 0 1px var(--line);
      }
      .lang-switch-code {
        font-family: var(--font-mono);
        font-size: 0.58rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: var(--text-soft);
        line-height: 1;
      }
      .lang-switch:hover .lang-switch-code {
        color: var(--text);
      }
    </style>
  </head>
  <body>
    <div class:list={["site-shell", bodyClass]}>
      <header class="site-header" id="site-header">
        <div class="container header-inner">
          <a class="brand" href="/">
            <img class="brand-logo" src="/images/logo-reuter-it.png" alt="REUTER IT NETWORKS" />
          </a>

          <nav class="nav" id="main-nav" aria-label={t.navAriaLabel}>
            {navigation.map((item) => (
              <a class:list={["nav-link", pathname === item.href && "is-active"]} href={item.href}>
                {item.label}
              </a>
            ))}
          </nav>

          <div class="header-actions">
            {altLangHref && (
              <a class="lang-switch" href={altLangHref} aria-label={t.switchAriaLabel}>
                {lang === "es" ? (
                  <svg class="lang-switch-flag" viewBox="0 0 32 24" role="img" aria-hidden="true">
                    <clipPath id="uk-clip"><rect width="32" height="24" rx="2" /></clipPath>
                    <g clip-path="url(#uk-clip)">
                      <rect width="32" height="24" fill="#3a3a38" />
                      <g stroke="#f5f5f0" stroke-width="4.5">
                        <line x1="0" y1="0" x2="32" y2="24" />
                        <line x1="32" y1="0" x2="0" y2="24" />
                      </g>
                      <g stroke="#8a8a85" stroke-width="1.6">
                        <line x1="0" y1="0" x2="32" y2="24" />
                        <line x1="32" y1="0" x2="0" y2="24" />
                      </g>
                      <rect x="12" width="8" height="24" fill="#f5f5f0" />
                      <rect y="8" width="32" height="8" fill="#f5f5f0" />
                      <rect x="14" width="4" height="24" fill="#8a8a85" />
                      <rect y="10" width="32" height="4" fill="#8a8a85" />
                    </g>
                  </svg>
                ) : (
                  <svg class="lang-switch-flag" viewBox="0 0 32 24" role="img" aria-hidden="true">
                    <rect width="32" height="24" rx="2" fill="#8a8a85" />
                    <rect y="6" width="32" height="12" fill="#f5f5f0" />
                  </svg>
                )}
                <span class="lang-switch-code">{t.switchTo}</span>
              </a>
            )}
            <a class="button button-primary header-cta" href={company.whatsappHref} target="_blank" rel="noreferrer">
              WhatsApp
            </a>
            <button class="burger" id="burger-btn" aria-label={t.openMenu} aria-expanded="false" aria-controls="main-nav">
              <span></span>
              <span></span>
              <span></span>
            </button>
          </div>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <div class="container footer-grid">
          <div>
            <p class="eyebrow">REUTER IT NETWORKS</p>
            <h2>{t.footerHeading}</h2>
            <p class="footer-copy">
              {t.footerCopy}
            </p>
            <div class="footer-nav">
              {navigation.map((item) => (
                <a href={item.href} class="footer-nav-link">{item.label}</a>
              ))}
            </div>
          </div>

          <div class="footer-card">
            <p class="eyebrow">{t.contact}</p>
            <ul class="footer-list">
              <li><a href={company.whatsappHref} target="_blank" rel="noreferrer">{t.whatsappDirect}</a></li>
              <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
              <li><a href={`tel:${company.phone}`}>{company.phone}</a></li>
              <li>{company.location}</li>
            </ul>
            <a class="button button-primary footer-cta" href={lang === "en" ? "/en/contact" : "/contacto"}>{t.requestQuote}</a>
          </div>
        </div>
        <div class="container footer-bottom">
          <p class="footer-legal">© <span id="footer-year"></span> REUTER IT NETWORKS. Córdoba, Argentina.</p>
        </div>
      </footer>
    </div>

    <div class="lightbox" id="lightbox" aria-hidden="true">
      <span class="lightbox-counter" id="lightbox-counter"></span>
      <button class="lightbox-close" id="lightbox-close" aria-label={t.close}>✕</button>
      <button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label={t.prev}>‹</button>
      <img class="lightbox-img" id="lightbox-img" src="" alt="" />
      <button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label={t.next}>›</button>
      <p class="lightbox-caption" id="lightbox-caption"></p>
    </div>

    <script>
      const yearEl = document.getElementById("footer-year");
      if (yearEl) yearEl.textContent = String(new Date().getFullYear());

      const burgerBtn = document.getElementById("burger-btn");
      const mainNav = document.getElementById("main-nav");
      const header = document.getElementById("site-header");

      burgerBtn?.addEventListener("click", () => {
        const isOpen = mainNav?.classList.toggle("nav-open");
        burgerBtn.setAttribute("aria-expanded", String(isOpen));
        burgerBtn.classList.toggle("is-open", isOpen);
      });

      mainNav?.querySelectorAll(".nav-link").forEach((link) => {
        link.addEventListener("click", () => {
          mainNav.classList.remove("nav-open");
          burgerBtn?.setAttribute("aria-expanded", "false");
          burgerBtn?.classList.remove("is-open");
        });
      });

      window.addEventListener("scroll", () => {
        header?.classList.toggle("header-scrolled", window.scrollY > 40);
      }, { passive: true });

      const revealEls = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("revealed");
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: "0px 0px -40px 0px" });
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add("revealed"));
      }

      // Lightbox compartido: cualquier imagen "navegable" de una sección
      // se agrupa con sus vecinas para poder pasarlas con ‹ › o flechas.
      (function () {
        const lb = document.getElementById("lightbox");
        const lbImg = document.getElementById("lightbox-img");
        const lbCap = document.getElementById("lightbox-caption");
        const lbCounter = document.getElementById("lightbox-counter");
        const lbClose = document.getElementById("lightbox-close");
        const lbPrev = document.getElementById("lightbox-prev");
        const lbNext = document.getElementById("lightbox-next");
        if (!lb || !lbImg) return;

        let gallery: { src: string; alt: string; caption: string }[] = [];
        let idx = 0;

        function open(items: typeof gallery, i: number) {
          gallery = items;
          idx = i;
          update();
          lb!.classList.add("is-open");
          lb!.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
        }
        function close() {
          lb!.classList.remove("is-open");
          lb!.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
        }
        function update() {
          const it = gallery[idx];
          if (!it) return;
          (lbImg as HTMLImageElement).src = it.src;
          (lbImg as HTMLImageElement).alt = it.alt || "";
          if (lbCap) lbCap.textContent = it.caption || "";
          if (lbCounter) lbCounter.textContent = `${idx + 1} / ${gallery.length}`;
        }
        function nav(d: number) {
          idx = (idx + d + gallery.length) % gallery.length;
          update();
        }

        lbClose?.addEventListener("click", close);
        lbPrev?.addEventListener("click", () => nav(-1));
        lbNext?.addEventListener("click", () => nav(1));
        document.addEventListener("keydown", (e) => {
          if (!lb!.classList.contains("is-open")) return;
          if (e.key === "Escape") close();
          if (e.key === "ArrowLeft") nav(-1);
          if (e.key === "ArrowRight") nav(1);
        });
        lb?.addEventListener("click", (e) => {
          if (e.target === lb) close();
        });

        const groupSelector =
          "section, article, .case-card, .work-slider, .mini-gallery, .story-rows, .team-editorial";
        const toItem = (img: Element) => {
          const el = img as HTMLImageElement;
          return { src: el.currentSrc || el.src, alt: el.alt, caption: el.alt };
        };
        const bindImage = (img: Element) => {
          img.addEventListener("click", () => {
            const root = img.closest(groupSelector) || document;
            const items = Array.from(root.querySelectorAll("img")).map(toItem);
            const mySrc = (img as HTMLImageElement).currentSrc || (img as HTMLImageElement).src;
            const startIdx = Math.max(0, items.findIndex((it) => it.src === mySrc));
            if (items.length) open(items, startIdx);
          });
        };

        document.querySelectorAll("[data-lightbox]").forEach((el) => {
          el.addEventListener("click", () => {
            const root = el.closest(groupSelector) || document;
            const items = Array.from(root.querySelectorAll("img")).map(toItem);
            const trigger = el.querySelector("img") as HTMLImageElement | null;
            const mySrc = trigger?.currentSrc || trigger?.src || "";
            const startIdx = Math.max(0, items.findIndex((it) => it.src === mySrc));
            if (items.length) open(items, startIdx);
          });
        });

        document
          .querySelectorAll(
            ".case-media img, .work-slide-image img, .mini-gallery-slide img, .story-row-media img, .team-feature img, .diagnostic-figure img"
          )
          .forEach(bindImage);
      })();
    </script>
  </body>
</html>
