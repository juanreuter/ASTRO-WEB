---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { cases } from "../../data/site.en";

const villaCabreraSlides = [
  {
    image: "/images/trabajos/villa-cabrera-01.jpeg",
    alt: "75-inch digital screen installed at a school in the Villa Cabrera neighborhood."
  },
  {
    image: "/images/trabajos/villa-cabrera-02.jpeg",
    alt: "View of the 75-inch digital screen installation in Villa Cabrera."
  },
  {
    image: "/images/trabajos/villa-cabrera-03.jpeg",
    alt: "Connecting and adjusting the 75-inch digital screen at the Villa Cabrera school."
  },
  {
    image: "/images/trabajos/villa-cabrera-04.jpeg",
    alt: "Digital screen connected and mounted in a classroom in Villa Cabrera."
  },
  {
    image: "/images/trabajos/villa-cabrera-05.jpeg",
    alt: "Digital screen installation process and network setup in Villa Cabrera."
  },
  {
    image: "/images/trabajos/villa-cabrera-06.jpeg",
    alt: "Digital screen installed at a school in the Villa Cabrera neighborhood."
  },
  {
    image: "/images/trabajos/villa-cabrera-07.jpeg",
    alt: "Final view of the 75-inch digital screen installation and connection in Villa Cabrera."
  }
];
---

<BaseLayout
  title="Case Studies | REUTER IT NETWORKS"
  description="Cases and projects that show REUTER IT NETWORKS' comprehensive approach."
  lang="en"
  altLangHref="/casos-reales"
>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-bg-grid"></div>
      <div class="hero-bg-orb hero-bg-orb-1"></div>
      <div class="hero-bg-noise"></div>
    </div>
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow">Case studies</p>
        <h1>The best way to demonstrate technical judgment is to show how real problems were solved.</h1>
        <p class="lead">
          These projects show real installations, support, and commissioning work at institutions and
          businesses where things needed to be solved properly, documented, and left fully working.
        </p>
      </div>
      <aside class="hero-panel reveal">
        <div class="panel-stack">
          <span class="panel-chip">What you'll see in each case</span>
          <ul class="hero-list">
            <li>A concrete problem in an institutional context.</li>
            <li>Installation, configuration, or support carried out on-site.</li>
            <li>A final result backed by technical judgment and operational focus.</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="page-section page-section-compact">
    <div class="container">
      <article class="card case-featured-story reveal">
        <div class="case-featured-copy">
          <p class="eyebrow">Villa Cabrera, Córdoba Capital</p>
          <h2>Installation and network connection of a 75-inch digital screen.</h2>
          <p>
            A recent project at a school in the Villa Cabrera neighborhood, with mounting, network
            connection, and commissioning of a digital screen to leave it ready for real classroom use.
          </p>
        </div>

        <div class="mini-gallery" id="villa-cabrera-gallery">
          <div class="mini-gallery-viewport">
            <div class="mini-gallery-track" id="villa-cabrera-track">
              {villaCabreraSlides.map((slide, index) => (
                <figure class="mini-gallery-slide">
                  <img src={slide.image} alt={slide.alt} loading={index === 0 ? "eager" : "lazy"} />
                </figure>
              ))}
            </div>
          </div>

          <div class="mini-gallery-controls">
            <button class="slider-button" type="button" id="villa-cabrera-prev" aria-label="Previous photo">
              Previous
            </button>

            <div class="work-slider-dots" id="villa-cabrera-dots"></div>

            <button class="slider-button" type="button" id="villa-cabrera-next" aria-label="Next photo">
              Next
            </button>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="page-section">
    <div class="container case-grid">
      {cases.map((item) => (
        <article class="card case-card reveal">
          {item.image ? (
            <div class="case-media">
              <img class="case-image" src={item.image} alt={item.imageAlt} loading="lazy" />
              {item.hoverImage && (
                <>
                  <img
                    class="case-image case-image-hover"
                    src={item.hoverImage}
                    alt={item.hoverImageAlt ?? item.imageAlt}
                    loading="lazy"
                  />
                  <span class="case-swap-chip">See another view</span>
                </>
              )}
            </div>
          ) : (
            <div class="case-placeholder">
              <small>Featured project</small>
              <strong>{item.location}</strong>
            </div>
          )}
          {item.video && (
            <div class="case-video-wrap">
              <div class="case-proof">
                <span>Real on-site proof</span>
                <strong>Working demo video</strong>
              </div>
              <video
                class="case-video"
                controls
                preload="metadata"
                playsinline
                poster={item.videoPoster ?? item.image}
              >
                <source src={item.video} type="video/mp4" />
                Your browser doesn't support HTML5 video.
              </video>
            </div>
          )}
          <div class="case-body">
            <p class="eyebrow">{item.location}</p>
            <h3>{item.title}</h3>
            <p><strong>Challenge:</strong> {item.challenge}</p>
            <p><strong>Solution:</strong> {item.solution}</p>
            <p><strong>Outcome:</strong> {item.outcome}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <script define:vars={{ villaSlideCount: villaCabreraSlides.length }}>
    const gallery = document.querySelector("#villa-cabrera-gallery");
    const track = document.querySelector("#villa-cabrera-track");
    const prevButton = document.querySelector("#villa-cabrera-prev");
    const nextButton = document.querySelector("#villa-cabrera-next");
    const dotsHost = document.querySelector("#villa-cabrera-dots");
    const slides = Array.from(document.querySelectorAll("#villa-cabrera-track .mini-gallery-slide"));

    let currentIndex = 0;
    let autoplayId;

    const renderDots = () => {
      if (!dotsHost) return;
      dotsHost.innerHTML = "";
      for (let index = 0; index < villaSlideCount; index += 1) {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "slider-dot";
        dot.setAttribute("aria-label", `Go to photo ${index + 1}`);
        dot.addEventListener("click", () => {
          updateSlider(index);
          restartAutoplay();
        });
        dotsHost.appendChild(dot);
      }
    };

    const syncDots = () => {
      if (!dotsHost) return;
      Array.from(dotsHost.querySelectorAll(".slider-dot")).forEach((dot, dotIndex) => {
        dot.classList.toggle("is-active", dotIndex === currentIndex);
      });
    };

    const updateSlider = (index) => {
      if (!track || !slides.length) return;
      currentIndex = (index + villaSlideCount) % villaSlideCount;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
      syncDots();
    };

    const restartAutoplay = () => {
      if (autoplayId) window.clearInterval(autoplayId);
      autoplayId = window.setInterval(() => updateSlider(currentIndex + 1), 3600);
    };

    prevButton?.addEventListener("click", () => {
      updateSlider(currentIndex - 1);
      restartAutoplay();
    });

    nextButton?.addEventListener("click", () => {
      updateSlider(currentIndex + 1);
      restartAutoplay();
    });

    gallery?.addEventListener("mouseenter", () => {
      if (autoplayId) window.clearInterval(autoplayId);
    });

    gallery?.addEventListener("mouseleave", () => {
      restartAutoplay();
    });

    renderDots();
    updateSlider(0);
    restartAutoplay();
  </script>
</BaseLayout>
