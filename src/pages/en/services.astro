---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { services, coverage } from "../../data/site.en";

const icons = {
  network: [
    "M4 9.5h16",
    "M8 5.5h8",
    "M8 13.5h8",
    "M6.5 17.5h11",
    "M5.5 4h13a1.5 1.5 0 0 1 1.5 1.5v9A1.5 1.5 0 0 1 18.5 16h-13A1.5 1.5 0 0 1 4 14.5v-9A1.5 1.5 0 0 1 5.5 4Z"
  ],
  server: [
    "M5.5 5.5h13a1.5 1.5 0 0 1 1.5 1.5v2a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 9V7a1.5 1.5 0 0 1 1.5-1.5Z",
    "M5.5 13.5h13a1.5 1.5 0 0 1 1.5 1.5v2a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17v-2a1.5 1.5 0 0 1 1.5-1.5Z",
    "M7 8h.01",
    "M7 16h.01",
    "M10 8h6",
    "M10 16h6"
  ],
  security: [
    "M12 3.5 18.5 6v5.2c0 4.1-2.6 7.8-6.5 9.3-3.9-1.5-6.5-5.2-6.5-9.3V6L12 3.5Z",
    "M9.6 11.8 11.3 13.5 14.7 10.1"
  ],
  software: [
    "M8 6.5 4.5 10 8 13.5",
    "M16 6.5 19.5 10 16 13.5",
    "M13.5 4.5 10.5 15.5",
    "M5.5 18.5h13"
  ],
  automation: [
    "M12 3.8 14.1 8.1l4.7.7-3.4 3.3.8 4.7-4.2-2.2-4.2 2.2.8-4.7-3.4-3.3 4.7-.7L12 3.8Z",
    "M12 14.6v4.6",
    "M9.2 18h5.6"
  ],
  support: [
    "M12 5.2a5.8 5.8 0 0 1 5.8 5.8v3.7",
    "M6.2 14.7A5.8 5.8 0 0 1 12 5.2",
    "M5.4 12.8h1.4a1.4 1.4 0 0 1 1.4 1.4v2.1a1.4 1.4 0 0 1-1.4 1.4H5.4A1.4 1.4 0 0 1 4 16.3v-2.1a1.4 1.4 0 0 1 1.4-1.4Z",
    "M17.2 12.8h1.4a1.4 1.4 0 0 1 1.4 1.4v2.1a1.4 1.4 0 0 1-1.4 1.4h-1.4a1.4 1.4 0 0 1-1.4-1.4v-2.1a1.4 1.4 0 0 1 1.4-1.4Z",
    "M9.8 17.7c.6.5 1.4.8 2.2.8s1.6-.3 2.2-.8"
  ]
} as const;

const territoryProjects = [
  {
    label: "Córdoba Capital",
    title: "Urban work and on-site response",
    image: "/images/trabajos/instalacion-altura.jpg",
    alt: "Camera installation in a school gymnasium in Córdoba Capital.",
    description:
      "In Córdoba Capital we work with educational institutions as well as businesses and offices. One clear example was installing cameras in the gymnasium of a school in Barrio Crisol, handling the mounting at height and commissioning in a real, everyday-use environment."
  },
  {
    label: "Provincial interior",
    title: "Planned deployments outside the capital",
    image: "/images/trabajos/rack-y-cableado.jpg",
    alt: "Rack and structured cabling installed at a school in the interior of Córdoba.",
    description:
      "We also carry out full projects in the interior of Córdoba. At a school in Cosquín we built a rack with patch panels and network distribution to Wi-Fi access points and end devices, leaving a far more organized and maintainable technical foundation."
  },
  {
    label: "Other provinces",
    title: "Projects driven by specific expertise",
    image: "/images/trabajos/formosa-pizarra-tactil.jpg",
    alt: "Installation of an interactive whiteboard and projector in Formosa.",
    description:
      "We can also work outside the province when the project justifies it. In Formosa we installed interactive whiteboards and projectors for Los Salesianos, in a job requested from Buenos Aires because of our prior experience handling, configuring, and testing delicate equipment."
  }
];
---

<BaseLayout
  title="Services | REUTER IT NETWORKS"
  description="Networks, security, servers, software, and automation with a comprehensive approach."
  lang="en"
  altLangHref="/servicios"
>
  <section class="hero editorial-hero services-editorial">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-bg-grid"></div>
      <div class="hero-bg-orb hero-bg-orb-1"></div>
      <div class="hero-bg-noise"></div>
    </div>
    <div class="container editorial-grid services-editorial-grid">
      <div class="editorial-copy reveal">
        <p class="eyebrow">Services</p>
        <h1>We specialize in diagnosing complex problems and finding solutions where other providers stop short.</h1>
        <p class="lead">
          We don't come in to fix one isolated piece and disappear. We organize the technical foundation,
          integrate whatever is needed, and leave a clearer structure to operate and grow on.
        </p>

        <div class="tag-row">
          <span class="tag">Schools & institutes</span>
          <span class="tag">Hotels</span>
          <span class="tag">Clinics & hospitals</span>
          <span class="tag">Businesses & offices</span>
        </div>
      </div>

      <figure class="diagnostic-figure diagnostic-figure-hero reveal">
        <img
          src="/images/trabajos/home-topologia-software-propio.png"
          alt="Deep network topology scanning and detection with REUTER IT's in-house software."
        />
        <figcaption>
          <small>Exclusive service</small>
          <strong>Deep topology scanning and detection with our own software.</strong>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="page-section services-list-section">
    <div class="container">
      <div class="section-heading editorial-heading reveal">
        <p class="eyebrow">What we do</p>
        <h2>Six areas that connect with each other.</h2>
      </div>

      <div class="service-listing reveal">
        {services.map((service) => (
          <article class="service-line">
            <span class="service-node" aria-hidden="true"></span>
            <span class="service-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                {icons[service.icon as keyof typeof icons].map((path) => (
                  <path d={path}></path>
                ))}
              </svg>
            </span>
            <div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section territory-section" id="coverage">
    <div class="container">
      <div class="section-heading editorial-heading reveal">
        <p class="eyebrow">Real reach</p>
        <h2>We work in the capital, in the interior, and also outside the province.</h2>
      </div>

      <div class="story-rows">
        {territoryProjects.map((project, index) => (
          <article class:list={["story-row", "reveal", index % 2 === 1 && "is-reverse"]}>
            <div class="story-row-media">
              <img src={project.image} alt={project.alt} loading="lazy" />
              <span class="story-node story-node-a" aria-hidden="true"></span>
              <span class="story-node story-node-b" aria-hidden="true"></span>
            </div>

            <div class="story-row-copy">
              <p class="eyebrow">{project.label}</p>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="coverage-grid reveal" style="margin-top: 2.5rem;">
        {coverage.map((item) => (
          <article class="metric">
            <strong>{item}</strong>
            <p>Response time depends on the technical, logistical, and operational scope of the project.</p>
          </article>
        ))}
      </div>

      <div class="two-column reveal" style="margin-top: 3rem;">
        <div class="section-heading tight">
          <p class="eyebrow">Business approach</p>
          <h3>Showing territorial reach also conveys seriousness.</h3>
          <p>
            For an institution or business, knowing that we can respond outside of a single city
            reduces uncertainty and improves the perception of backup support. That includes projects carried out
            in other provinces, such as installations completed in Formosa.
          </p>
        </div>
        <div class="signal-panel">
          <div class="signal-row">
            <span>Home base</span>
            <strong>Córdoba</strong>
          </div>
          <div class="signal-row">
            <span>Provincial interior</span>
            <strong>Planned deployments and coordinated support</strong>
          </div>
          <div class="signal-row">
            <span>Nationwide projects</span>
            <strong>Depending on technical need, operational feasibility, and project scope</strong>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
