---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { company } from "../../data/site.en";

const numbers = [
  { value: "20+ years", label: "of technology track record" },
  {
    value: "128 institutions",
    label: "prior experience providing technology advisory within an educational organization"
  },
  { value: "11 institutions", label: "currently served through recurring technical services" }
];

// Placeholders ready to receive photo/name/role/summary/specialties/LinkedIn
// for each partner. Juan and Germán's details confirmed by the client.
const team = [
  {
    name: "Juan Reuter",
    role: "Infrastructure, networks, and development",
    photo: "/images/team/juan-reuter.png",
    summary:
      "Technology career focused on IT infrastructure, networks, and servers, with Cisco Networking Academy training (full CCNA program). Development and deployment of AI-assisted systems as part of the working method.",
    specialties: ["Networks & MikroTik", "Linux servers", "Software development"],
    linkedin: ""
  },
  {
    name: "Germán Francisco Reuter",
    role: "Networks, on-site support, and video surveillance",
    photo: "/images/team/socio.png",
    summary:
      "Technology career focused on networks, on-site technical support, and video surveillance, with an emphasis on direct advisory work for institutions and businesses.",
    specialties: ["Networks", "On-site support", "IP cameras & video surveillance", "Technology advisory"],
    linkedin: ""
  }
];

const sliderItems = [
  {
    image: "/images/trabajos/formosa-pizarra-tactil.jpg",
    alt: "Interactive whiteboard installation in Formosa.",
    title: "Formosa",
    text: "Interactive whiteboards and projectors"
  },
  {
    image: "/images/trabajos/bar-redes-y-pantalla.jpg",
    alt: "Operational technology installed at a bar in Güemes.",
    title: "Güemes, Córdoba",
    text: "Segmented network and LED screen"
  },
  {
    image: "/images/trabajos/villa-cabrera-01.jpeg",
    alt: "75-inch digital screen installed at a school in the Villa Cabrera neighborhood.",
    title: "Villa Cabrera",
    text: "75-inch digital screen connected to the network"
  },
  {
    image: "/images/trabajos/proyector-instalacion.jpg",
    alt: "Projector installation in a classroom.",
    title: "Multimedia classroom",
    text: "Projector mounting and adjustment"
  },
  {
    image: "/images/trabajos/mesa-pruebas-red.jpg",
    alt: "Testing lab with networking equipment and connectivity gear before recommending them to clients.",
    title: "In-house lab",
    text: "We test equipment and protect budgets before recommending what to buy"
  },
  {
    image: "/images/trabajos/coordinacion-transmision.jpg",
    alt: "Technical coordination of a broadcast during the pandemic.",
    title: "Pandemic",
    text: "YouTube livestream for a conference during the pandemic"
  },
  {
    image: "/images/trabajos/rack-y-cableado.jpg",
    alt: "Rack and cabling installed at a school.",
    title: "Cosquín",
    text: "Rack, patch panels, and network distribution"
  },
  {
    image: "/images/trabajos/transmision-diplomas.jpg",
    alt: "Technical operation for a graduation ceremony broadcast during the pandemic.",
    title: "Higher education institute",
    text: "YouTube broadcast for a graduation ceremony"
  },
  {
    image: "/images/trabajos/capacitacion-laboratorio.jpg",
    alt: "Closing of the CCNA course at UTN Córdoba.",
    title: "UTN Córdoba",
    text: "Technical training and professional path"
  },
  {
    image: "/images/trabajos/despenaderos-netbooks.jpg",
    alt: "Preparing netbooks at a school in Despeñaderos late on a Friday.",
    title: "Despeñaderos",
    text: "Preparing netbooks late on a Friday"
  }
];
---

<BaseLayout
  title="About Us | REUTER IT NETWORKS"
  description="Professional profile and comprehensive approach of REUTER IT NETWORKS."
  lang="en"
  altLangHref="/nosotros"
>
  <section class="hero editorial-hero about-hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-bg-grid"></div>
      <div class="hero-bg-orb hero-bg-orb-1"></div>
      <div class="hero-bg-noise"></div>
    </div>
    <div class="container editorial-grid about-grid">
      <div class="editorial-copy reveal">
        <p class="eyebrow">About us</p>
        <h1>We don't sell loose tasks. We come in to put the whole system in order.</h1>
        <p class="lead">
          We understand how connectivity, servers, security, software, and automation relate to each other,
          and we take responsibility for making it all work under the same technical judgment.
        </p>
      </div>

      <div class="approach-lines reveal">
        <div>
          <small>01</small>
          <strong>Clear diagnosis</strong>
          <span class="approach-node" aria-hidden="true"></span>
        </div>
        <div>
          <small>02</small>
          <strong>Implementation with judgment</strong>
          <span class="approach-node" aria-hidden="true"></span>
        </div>
        <div>
          <small>03</small>
          <strong>Real on-site follow-up</strong>
          <span class="approach-node" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container team-editorial">
      <figure class="team-feature team-feature-wide team-feature-flex reveal">
        <img
          src="/images/trabajos/reuter-trabajo-institucional-completo.jpg"
          alt="Technical work at an institution with several laptops being serviced."
          loading="lazy"
        />

        <figcaption>
          <strong>Real work at institutions</strong>
          <span>Review, preparation, and fine-tuning of equipment in an educational setting.</span>
        </figcaption>
      </figure>

      <figure class="team-feature team-feature-tall team-feature-flex reveal">
        <img
          src="/images/trabajos/reuter-en-sitio.jpg"
          alt="On-site technical presence with work tools."
          loading="lazy"
        />
        <div class="team-pins" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <figcaption>
          <strong>Presence in the field</strong>
          <span>Diagnosis, implementation, and direct follow-up right where the work actually happens.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-heading editorial-heading tight reveal">
        <p class="eyebrow">Real track record</p>
        <h2>Different situations, the same technical judgment.</h2>
      </div>

      <div class="work-slider editorial-slider reveal" id="work-slider">
        <div class="work-slider-viewport">
          <div class="work-slider-track" id="work-slider-track">
            {sliderItems.map((item) => (
              <article class="work-slide">
                <div class="work-slide-image">
                  <img src={item.image} alt={item.alt} loading="lazy" />
                </div>
                <div class="work-slide-copy">
                  <span>{item.title}</span>
                  <strong>{item.text}</strong>
                </div>
              </article>
            ))}
          </div>
        </div>

        <div class="work-slider-controls">
          <button class="slider-button" type="button" id="work-slider-prev" aria-label="Previous photo">
            Previous
          </button>

          <div class="work-slider-dots" id="work-slider-dots"></div>

          <button class="slider-button" type="button" id="work-slider-next" aria-label="Next photo">
            Next
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section-compact">
    <div class="container">
      <div class="coverage-grid reveal">
        {numbers.map((item) => (
          <article class="metric">
            <strong>{item.value}</strong>
            <p>{item.label}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-heading editorial-heading reveal">
        <p class="eyebrow">The team</p>
        <h2>Complementary skills within a single company.</h2>
      </div>
      <div class="team-grid reveal">
        {team.map((person) => (
          person.name ? (
            <article class="team-person-card">
              <div class="team-person-photo">
                {person.photo ? <img src={person.photo} alt={person.name} /> : person.name.charAt(0)}
              </div>
              <h3>{person.name}</h3>
              <span class="team-person-role">{person.role}</span>
              <p class="team-person-summary">{person.summary}</p>
              {person.specialties.length > 0 && (
                <div class="team-person-specialties">
                  {person.specialties.map((s) => <span class="tag">{s}</span>)}
                </div>
              )}
              {person.linkedin && <a class="team-person-link" href={person.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>}
            </article>
          ) : (
            <article class="team-person-card" style="justify-content: center; align-items: center; text-align: center; opacity: 0.6;">
              <div class="team-person-photo">?</div>
              <h3>Coming soon</h3>
              <span class="team-person-role">Second partner</span>
              <p class="team-person-summary">Space ready for photo, role, summary, and specialties.</p>
            </article>
          )
        ))}
      </div>
    </div>
  </section>

  <section class="page-section-compact">
    <div class="container">
      <div class="ai-note reveal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3.8 14.1 8.1l4.7.7-3.4 3.3.8 4.7-4.2-2.2-4.2 2.2.8-4.7-3.4-3.3 4.7-.7L12 3.8Z"></path>
        </svg>
        <p>
          We use modern artificial intelligence tools as part of our working method:
          to speed up development, scripting, automation, diagnosis, documentation, and prototyping.
          <strong> AI as an engineering and productivity tool, always under technical supervision</strong> —
          it doesn't replace judgment, it accelerates it.
        </p>
      </div>
    </div>
  </section>

  <section class="page-section about-quote">
    <div class="container open-quote reveal">
      <p class="eyebrow">Behind the scenes</p>
      <h2>"If I look like the one who works the least in the photos, it's only because I'm the one who remembers to take the picture."</h2>
      <div class="actions">
        <a class="button button-primary" href="/en/contact">Talk about your project</a>
        <a class="button button-secondary" href={company.whatsappHref} target="_blank" rel="noreferrer">
          Ask us on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <script define:vars={{ slideCount: sliderItems.length }}>
    const slider = document.querySelector("#work-slider");
    const track = document.querySelector("#work-slider-track");
    const prevButton = document.querySelector("#work-slider-prev");
    const nextButton = document.querySelector("#work-slider-next");
    const dotsHost = document.querySelector("#work-slider-dots");
    const slides = Array.from(document.querySelectorAll("#work-slider-track .work-slide"));

    let currentIndex = 0;
    let autoplayId;
    let pageCount = 0;
    let visibleCount = 1;

    const getVisibleCount = () => {
      if (window.innerWidth <= 720) return 1;
      if (window.innerWidth <= 1050) return 2;
      return 3;
    };

    const renderDots = () => {
      if (!dotsHost) return;
      dotsHost.innerHTML = "";
      for (let index = 0; index < pageCount; index += 1) {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "slider-dot";
        dot.setAttribute("aria-label", `Go to group ${index + 1}`);
        dot.dataset.index = String(index);
        dot.addEventListener("click", () => {
          updateSlider(index);
          restartAutoplay();
        });
        dotsHost.appendChild(dot);
      }
    };

    const syncDots = () => {
      if (!dotsHost) return;
      Array.from(dotsHost.querySelectorAll(".slider-dot")).forEach((dot, dotIndex) => {
        dot.classList.toggle("is-active", dotIndex === currentIndex);
      });
    };

    const updateSlider = (index) => {
      if (!track || !slides.length) return;
      currentIndex = (index + pageCount) % pageCount;
      track.style.transform = `translateX(-${slides[currentIndex].offsetLeft}px)`;
      syncDots();
    };

    const recalculateSlider = () => {
      visibleCount = getVisibleCount();
      pageCount = Math.max(1, slideCount - visibleCount + 1);
      currentIndex = Math.min(currentIndex, pageCount - 1);
      renderDots();
      updateSlider(currentIndex);
    };

    const restartAutoplay = () => {
      if (autoplayId) window.clearInterval(autoplayId);
      autoplayId = window.setInterval(() => updateSlider(currentIndex + 1), 4500);
    };

    prevButton?.addEventListener("click", () => {
      updateSlider(currentIndex - 1);
      restartAutoplay();
    });

    nextButton?.addEventListener("click", () => {
      updateSlider(currentIndex + 1);
      restartAutoplay();
    });

    slider?.addEventListener("mouseenter", () => {
      if (autoplayId) window.clearInterval(autoplayId);
    });

    slider?.addEventListener("mouseleave", () => {
      restartAutoplay();
    });

    window.addEventListener("resize", recalculateSlider);

    recalculateSlider();
    restartAutoplay();
  </script>
</BaseLayout>
