---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { company, partnerBrands, ownSolutions } from "../../data/site.en";

const slugify = (name: string) => name.toLowerCase().replace(/\s+/g, "-");
// The ribbon repeats twice so the marquee loops without gaps.
const ribbonBrands = [...partnerBrands, ...partnerBrands];
---

<BaseLayout
  title="REUTER IT NETWORKS | Comprehensive Technology Solutions"
  description="Networks, servers, security, software, and automation for institutions and businesses in Córdoba, Argentina."
  lang="en"
  altLangHref="/"
>
  <section class="hero editorial-hero home-hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-bg-grid"></div>
      <div class="hero-bg-orb hero-bg-orb-1"></div>
      <div class="hero-bg-orb hero-bg-orb-2"></div>
      <div class="hero-bg-noise"></div>
      <div class="hero-bg-particles" id="hero-particles"></div>
    </div>
    <div class="container editorial-grid">
      <div class="editorial-copy reveal">
        <p class="eyebrow">Infrastructure that backs up daily operations</p>
        <h1>
          Comprehensive technology
          <span class="gradient-word">solutions</span>
          for institutions and businesses
        </h1>
        <p class="lead">
          Networks, servers, cameras, and software integrated into a single, reliable solution.
        </p>

        <div class="actions">
          <a class="button button-primary" href="/en/contact">Request a quote</a>
          <a class="button button-secondary" href={company.whatsappHref} target="_blank" rel="noreferrer">
            Talk to us on WhatsApp
          </a>
        </div>

        <ul class="inline-proof">
          <li>Diagnosis before replacement.</li>
          <li>One strategy across several technical layers.</li>
          <li>Real-world judgment for institutions and businesses.</li>
        </ul>
      </div>

      <div class="editorial-stage editorial-stage-full reveal">
        <figure class="stage-primary stage-primary-large" data-lightbox>
          <img src="/images/trabajos/home-equipo-rack.png" alt="REUTER's technical team in front of a rack installed and cabled on-site." />
          <figcaption>
            <small>Real work on-site</small>
            <strong>Testing, review, and fine-tuning before calling a problem solved.</strong>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="brand-ribbon-section" aria-label="Brands we work with">
    <div class="container">
      <div class="brand-ribbon-mask">
        <div class="brand-ribbon-track">
          {ribbonBrands.map((brand) => (
            <img class="brand-ribbon-logo" src={`/images/brands/${slugify(brand)}.png`} alt={brand} loading="lazy" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="page-section home-thesis">
    <div class="container thesis-row">
      <div class="thesis-copy reveal">
        <p class="eyebrow">Case studies</p>
        <h2>We don't start by saying "you need to buy everything new" — we start by diagnosing the problem.</h2>
      </div>

      <div class="thesis-actions reveal">
        <span class="mono-note">When the work can be shown, the decision becomes a lot clearer.</span>
        <a class="button button-secondary" href="/en/case-studies">See all case studies</a>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-heading editorial-heading reveal">
        <p class="eyebrow">In-house solutions</p>
        <h2>Our solutions</h2>
        <p>Tools born from problems we've found working with real institutions.</p>
      </div>

      <div class="solutions-grid reveal">
        {ownSolutions.map((solution) => (
          <article class="solution-card">
            <div class:list={["solution-media", solution.imageContain && "is-contain"]}>
              <img src={solution.image} alt={solution.imageAlt} loading="lazy" />
            </div>
            <div class="solution-body">
              <span class="solution-category">{solution.category}</span>
              <h3>{solution.name}</h3>
              <p>{solution.summary}</p>
              <ul class="solution-bullets">
                {solution.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
              <a class="solution-cta" href={`/en/software#${solution.slug}`}>See solution →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section home-cta">
    <div class="container cta-row">
      <div class="cta-copy reveal">
        <p class="eyebrow">Direct contact</p>
        <h2>If you're relying on too many patches today, let's talk before the problem grows.</h2>
      </div>

      <div class="actions reveal">
        <a class="button button-primary" href="/en/contact">Request a diagnosis</a>
        <a class="button button-secondary" href={company.whatsappHref} target="_blank" rel="noreferrer">
          Talk now on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <script>
    // Decorative particles for the Home hero.
    (function () {
      const host = document.getElementById("hero-particles");
      if (!host) return;
      const COUNT = 18;
      for (let i = 0; i < COUNT; i++) {
        const p = document.createElement("span");
        p.style.left = Math.random() * 100 + "%";
        p.style.bottom = -Math.random() * 30 + "%";
        p.style.animationDuration = 10 + Math.random() * 14 + "s";
        p.style.animationDelay = Math.random() * 12 + "s";
        p.style.width = p.style.height = 2 + Math.random() * 3 + "px";
        host.appendChild(p);
      }
    })();
  </script>
</BaseLayout>
