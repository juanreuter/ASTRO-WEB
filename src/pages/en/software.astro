---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Projects with a "uniform" format (image + copy + tags), grouped by category.
// ComuCon and Self-Hosted Infrastructure have their own content (flow diagram /
// recovery steps) and are written separately, further down in the markup.
const platformProjects = [
  {
    id: "miaulanube",
    kicker: "Educational platform (LMS) — multi-tenant",
    title: "MiAulaNube",
    description:
      "A complete virtual classroom built from scratch: multi-institution (each school operates independently within the same architecture), courses with units and topics, auto-graded assessments, assignments with submission and grading, forums, internal messaging, notifications (push and email), and class recording with a digital whiteboard. Designed from real, hands-on experience working with educational institutions. It's in production today, with a public demo anyone can try.",
    link: { href: "https://miaulanube.com", label: "Visit miaulanube.com ↗" },
    tags: ["Next.js", "PostgreSQL", "Prisma", "Docker", "Multi-tenant"],
    media: { type: "single" as const, src: "/images/desarrollo/mian-hero.png", alt: "MiAulaNube landing page" }
  }
];

const toolProjects = [
  {
    id: "nettopo",
    kicker: "Network discovery & mapping",
    title: "NetTopo Discovery + NetPlanner",
    lead: "Going from a network nobody fully understands to infrastructure that's surveyed, visible, and documented.",
    descriptionPre:
      "An automatic discovery engine that maps a network's real topology — neighbors via LLDP/CDP/MNDP, MAC tables, ARP, and direct data from MikroTik routers via RouterOS — and feeds it into ",
    descriptionStrong: "NetPlanner",
    descriptionPost:
      ", an in-house visual mapping tool where every device, port, and connection is documented and navigable. Built to survey a network in the field with just a laptop or a Raspberry Pi, and to speed up troubleshooting the day something breaks.",
    tags: ["Python", "SNMP / LLDP / CDP / MNDP", "ARP / MAC tables", "RouterOS", "Node.js", "Raspberry Pi"],
    media: {
      type: "two-up" as const,
      items: [
        { src: "/images/desarrollo/netplanner-list.png", alt: "Equipment list in NetPlanner" },
        { src: "/images/desarrollo/netplanner-topo.png", alt: "Topology map in NetPlanner" }
      ]
    }
  }
];

const internalProjects = [
  {
    id: "facturacion",
    kicker: "Internal management system",
    title: "Internal Billing System",
    description:
      "An in-house system to manage clients, log completed tasks, and generate monthly invoices, with automatic revenue splitting between partners and real-time sync against a custom SQL database. Replaced loose spreadsheets with a single place to work.",
    tags: ["JavaScript", "SQL", "Custom backend"],
    media: { type: "single" as const, src: "/images/desarrollo/facturacion-stats.png", alt: "Billing system dashboard" }
  },
  {
    id: "cefyt",
    kicker: "Academic management",
    title: "CEFyT — Higher Education Institute",
    description:
      "A management system for a higher education institute: degree programs, students, faculty, courses, an academic calendar with schedules by program and year, and enrollment history — all in a custom institutional dashboard, tailored to how the institute actually works.",
    tags: ["PHP", "MySQL"],
    media: { type: "single" as const, src: "/images/desarrollo/cefyt-stats.png", alt: "CEFyT administration dashboard" },
    reverse: true
  }
];
---

<BaseLayout
  title="Software & Platforms | REUTER IT NETWORKS"
  description="In-house platforms, network tools, custom management systems, and self-hosted infrastructure: the real software behind the infrastructure we deploy."
  ogImage="/images/desarrollo/mian-hero.png"
  bodyClass="dev-scope"
  lang="en"
  altLangHref="/desarrollo"
>
  <style is:global>
    /* ============================================================
       "Software & Platforms" section — own palette (MiAulaNube)
       Keeps the site's shell/typography; the accent shifts
       from teal to blue/orange only within .dev-scope.
       ============================================================ */
    .dev-scope {
      --accent: #3b82f6;
      --accent-2: #f97316;
      --accent-deep: #1e40af;
      --accent-soft: rgba(59, 130, 246, 0.12);
      --accent-2-soft: rgba(249, 115, 22, 0.14);
    }
    .dev-hero { padding: clamp(3rem, 6vw, 5rem) 0 clamp(2rem, 4vw, 3rem); }
    .dev-hero .hero-bg-orb-1 { background: radial-gradient(circle, rgba(59, 130, 246, 0.4), transparent 70%); }
    .dev-hero .hero-bg-orb-2 { background: radial-gradient(circle, rgba(249, 115, 22, 0.28), transparent 70%); }
    .dev-hero .hero-bg-grid {
      background-image:
        linear-gradient(rgba(59, 130, 246, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(59, 130, 246, 0.05) 1px, transparent 1px);
    }
    .dev-stack-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.75rem; }

    /* ---- capability strip ---- */
    .dev-capabilities {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      border-top: 1px solid var(--line);
      border-left: 1px solid var(--line);
    }
    .dev-cap {
      padding: 2rem 1.5rem;
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }
    .dev-cap-num {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--accent);
      letter-spacing: 0.08em;
      margin-bottom: 0.9rem;
      display: block;
    }
    .dev-cap h3 { margin-bottom: 0.5rem; }
    .dev-cap p { font-size: 0.92rem; }
    @media (max-width: 900px) { .dev-capabilities { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 560px) { .dev-capabilities { grid-template-columns: 1fr; } }

    /* ---- project rows ---- */
    .dev-projects { display: flex; flex-direction: column; gap: clamp(3rem, 5vw, 5rem); }
    .dev-project { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }
    .dev-project.rev .dev-project-media { order: 2; }
    .dev-project.rev .dev-project-copy { order: 1; }
    .dev-project-media {
      position: relative; border-radius: 0.85rem; overflow: hidden;
      border: 1px solid rgba(59, 130, 246, 0.25);
      box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
      background: #0a0a0a;
    }
    .dev-project-media img { width: 100%; display: block; }
    .dev-project-media.two-up { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; background: rgba(59, 130, 246, 0.15); }
    .dev-project-media.two-up img { height: 260px; object-fit: cover; }
    /* ---- ComuCon screenshot carousel ---- */
    .dev-project-media.comucon-slider {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0a0f16;
      padding: 2.5rem 1rem 3.25rem;
    }
    .comucon-slide-track { display: flex; width: 100%; transition: transform 0.45s ease; }
    .comucon-slide { flex: 0 0 100%; display: flex; justify-content: center; }
    .comucon-slide img {
      width: 100%;
      max-width: 300px;
      display: block;
      border-radius: 1.1rem;
      border: 1px solid rgba(59, 130, 246, 0.3);
      box-shadow: 0 25px 45px -18px rgba(0, 0, 0, 0.65);
    }
    .comucon-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 2.4rem;
      height: 2.4rem;
      border-radius: 50%;
      border: 1px solid rgba(59, 130, 246, 0.35);
      background: rgba(10, 15, 22, 0.8);
      color: #fff;
      font-size: 1.3rem;
      line-height: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    .comucon-nav:hover { border-color: var(--accent); color: var(--accent); }
    .comucon-nav.prev { left: 0.75rem; }
    .comucon-nav.next { right: 0.75rem; }
    .comucon-dots { position: absolute; bottom: 1.1rem; left: 50%; transform: translateX(-50%); display: flex; gap: 0.45rem; }
    .comucon-dot { width: 6px; height: 6px; padding: 0; border: none; border-radius: 50%; background: rgba(255, 255, 255, 0.28); cursor: pointer; }
    .comucon-dot.is-active { background: var(--accent); }
    .dev-project-kicker { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-2); margin-bottom: 0.75rem; display: block; }
    .dev-project-copy h3 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(1.5rem, 2.2vw, 2rem); margin-bottom: 0.9rem; letter-spacing: -0.01em; }
    .dev-project-copy p { margin-bottom: 1.1rem; }
    .dev-project-lead { color: var(--text); font-style: italic; font-family: var(--font-serif); font-size: 1.05rem !important; }
    .dev-project-copy .tag-row { margin-top: 1.25rem; }
    .dev-project-copy .tag:hover { color: var(--accent); border-color: var(--accent); }
    .dev-project-link { display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--font-mono); font-size: 0.82rem; color: var(--accent); border-bottom: 1px solid transparent; }
    .dev-project-link:hover { border-bottom-color: var(--accent); }
    @media (max-width: 820px) {
      .dev-project { grid-template-columns: 1fr; }
      .dev-project.rev .dev-project-media { order: 1; }
      .dev-project.rev .dev-project-copy { order: 2; }
    }

    .dev-cta { border-color: rgba(59, 130, 246, 0.3) !important; }
    .dev-cta .button-primary { background: var(--accent-2); border-color: var(--accent-2); box-shadow: 4px 4px 0 rgba(249, 115, 22, 0.25); }
    .dev-cta .button-primary:hover { background: #ea6a0a; border-color: #ea6a0a; }
  </style>

  <section class="hero dev-hero editorial-hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-bg-grid"></div>
      <div class="hero-bg-orb hero-bg-orb-1"></div>
      <div class="hero-bg-orb hero-bg-orb-2"></div>
      <div class="hero-bg-noise"></div>
    </div>
    <div class="container">
      <div class="editorial-copy reveal" style="max-width:44rem;">
        <p class="eyebrow">Software & Platforms</p>
        <h1>Custom software, backed by <span class="gradient-word">real infrastructure</span></h1>
        <p class="lead">
          We don't just install networks: we design, build, and deploy the systems that run on top of them
          — and we keep them running in production, every single day.
        </p>
        <div class="dev-stack-row">
          <span class="tag">Next.js / React</span>
          <span class="tag">Node.js</span>
          <span class="tag">PostgreSQL / MySQL</span>
          <span class="tag">Docker</span>
          <span class="tag">Python</span>
          <span class="tag">PHP</span>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section-compact">
    <div class="container">
      <div class="dev-capabilities reveal">
        <div class="dev-cap">
          <span class="dev-cap-num">01</span>
          <h3>Custom platforms</h3>
          <p>LMS, management systems, and institutional portals, built and deployed end to end — not just the screen, but the backend and database too.</p>
        </div>
        <div class="dev-cap">
          <span class="dev-cap-num">02</span>
          <h3>Infrastructure & deployment</h3>
          <p>Linux servers, Docker containers, reverse proxies, databases, and backups — the same real server, not an isolated demo.</p>
        </div>
        <div class="dev-cap">
          <span class="dev-cap-num">03</span>
          <h3>DNS, email & security</h3>
          <p>Domains, DNS, transactional email delivery, certificates, and access — the invisible part that makes everything else work.</p>
        </div>
        <div class="dev-cap">
          <span class="dev-cap-num">04</span>
          <h3>Automation</h3>
          <p>Scripts, integrations, and custom internal tools to take repetitive tasks off your plate.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-heading editorial-heading reveal">
        <p class="eyebrow">Projects</p>
        <h2>In-house platforms, technical tools, and infrastructure</h2>
      </div>

      <div class="dev-projects">

        <div class="dev-category-heading reveal">
          <span>01</span>
          <h3>Platforms</h3>
        </div>

        {platformProjects.map((project) => (
          <article class="dev-project reveal" id={project.id}>
            <div class="dev-project-media">
              <img src={project.media.src} alt={project.media.alt} />
            </div>
            <div class="dev-project-copy">
              <span class="dev-project-kicker">{project.kicker}</span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <a class="dev-project-link" href={project.link.href} target="_blank" rel="noreferrer">{project.link.label}</a>
              <div class="tag-row">
                {project.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </article>
        ))}

        <!-- ComuCon: own content (real app screenshots, doesn't fit the generic template) -->
        <article class="dev-project rev reveal" id="comucon">
          <div class="dev-project-media comucon-slider" id="comucon-slider">
            <div class="comucon-slide-track" id="comucon-slide-track">
              <div class="comucon-slide"><img src="/images/desarrollo/comucon-1.jpg" alt="ComuCon app login screen" loading="lazy" /></div>
              <div class="comucon-slide"><img src="/images/desarrollo/comucon-2.jpg" alt="List of announcements and authorizations sent in ComuCon, with parents' signature status" loading="lazy" /></div>
              <div class="comucon-slide"><img src="/images/desarrollo/comucon-3.jpg" alt="Detail of an authorization showing which parents haven't signed yet" loading="lazy" /></div>
              <div class="comucon-slide"><img src="/images/desarrollo/comucon-4.jpg" alt="Selector to create a new authorization or announcement in ComuCon" loading="lazy" /></div>
            </div>
            <button class="comucon-nav prev" type="button" aria-label="Previous screenshot">‹</button>
            <button class="comucon-nav next" type="button" aria-label="Next screenshot">›</button>
            <div class="comucon-dots" id="comucon-dots"></div>
          </div>
          <div class="dev-project-copy">
            <span class="dev-project-kicker">Institutional communication — Connected Community</span>
            <h3>ComuCon</h3>
            <p>
              A hierarchical, real-time institutional communication system, primarily aimed at educational
              institutions. It replaces traditional processes like the physical notice notebook with direct,
              traceable, organized digital communication between the institution and families.
            </p>
            <div class="flow-diagram" role="img" aria-label="Flow: the Institution sends a Communication or Authorization to the Family, who responds in real time, and it gets logged at the Institution.">
              <div class="flow-step">
                <span class="flow-step-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5h16"></path><path d="M8 5.5h8"></path><path d="M8 13.5h8"></path><path d="M6.5 17.5h11"></path><path d="M5.5 4h13a1.5 1.5 0 0 1 1.5 1.5v9A1.5 1.5 0 0 1 18.5 16h-13A1.5 1.5 0 0 1 4 14.5v-9A1.5 1.5 0 0 1 5.5 4Z"></path></svg>
                </span>
                <span>Institution</span>
              </div>
              <span class="flow-arrow" aria-hidden="true">→</span>
              <div class="flow-step">
                <span class="flow-step-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6.5 4.5 10 8 13.5"></path><path d="M16 6.5 19.5 10 16 13.5"></path></svg>
                </span>
                <span>Communication / Authorization</span>
              </div>
              <span class="flow-arrow" aria-hidden="true">→</span>
              <div class="flow-step">
                <span class="flow-step-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.2"></circle><path d="M5.5 19.5c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"></path></svg>
                </span>
                <span>Family</span>
              </div>
              <span class="flow-arrow" aria-hidden="true">→</span>
              <div class="flow-step">
                <span class="flow-step-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.6 11.8 11.3 13.5 14.7 10.1"></path><path d="M12 3.5 18.5 6v5.2c0 4.1-2.6 7.8-6.5 9.3-3.9-1.5-6.5-5.2-6.5-9.3V6L12 3.5Z"></path></svg>
                </span>
                <span>Logged response</span>
              </div>
            </div>
            <p style="margin-top: 1.25rem;"><strong>Communications:</strong> informational messages that don't require action from the recipient; the institution can see whether the message was read.</p>
            <p><strong>Authorizations:</strong> messages that require a decision from the parent or guardian (authorize / do not authorize). The response reaches the institution in real time, gets logged, and there's full traceability of consent.</p>
            <div class="comucon-modes">
              <span class="tag">Android App</span>
              <span class="tag">PWA</span>
              <span class="tag">Installable on PC</span>
              <span class="tag">Installable on iPhone/iOS (PWA)</span>
            </div>
          </div>
        </article>

        <div class="dev-category-heading reveal">
          <span>02</span>
          <h3>Technical tools</h3>
        </div>

        {toolProjects.map((project) => (
          <article class="dev-project reveal" id={project.id}>
            <div class="dev-project-media two-up">
              {project.media.items.map((item) => <img src={item.src} alt={item.alt} />)}
            </div>
            <div class="dev-project-copy">
              <span class="dev-project-kicker">{project.kicker}</span>
              <h3>{project.title}</h3>
              <p class="dev-project-lead">{project.lead}</p>
              <p>{project.descriptionPre}<strong>{project.descriptionStrong}</strong>{project.descriptionPost}</p>
              <div class="tag-row">
                {project.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </article>
        ))}

        <div class="dev-category-heading reveal">
          <span>03</span>
          <h3>Internal & custom systems</h3>
        </div>

        {internalProjects.map((project) => (
          <article class:list={["dev-project", "reveal", project.reverse && "rev"]} id={project.id}>
            <div class="dev-project-media">
              <img src={project.media.src} alt={project.media.alt} />
            </div>
            <div class="dev-project-copy">
              <span class="dev-project-kicker">{project.kicker}</span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="tag-row">
                {project.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </article>
        ))}

        <div class="dev-category-heading reveal">
          <span>04</span>
          <h3>Infrastructure</h3>
        </div>

        <!-- Self-hosted: own content (recovery steps, doesn't fit the generic template) -->
        <article class="dev-project reveal" id="self-hosted">
          <div class="dev-project-media">
            <img
              src="/images/desarrollo/self-hosted-arquitectura.png"
              alt="Diagram of the self-hosted backup, disaster recovery, and remote access architecture: institutions connected via Tailscale VPN to our own server running UrBackup and self-hosted RustDesk, with remote access for administrative staff and technical support."
              loading="lazy"
            />
          </div>
          <div class="dev-project-copy">
            <span class="dev-project-kicker">Backup, disaster recovery & remote access</span>
            <h3>Self-Hosted Infrastructure</h3>
            <p>
              We combine <strong>Tailscale</strong> (a private network that securely connects devices from
              different institutions to our server), <strong>UrBackup</strong> (a central backup server that
              we manage ourselves, with clients on each remote device making automatic copies over that
              private network), and self-hosted <strong>RustDesk</strong> (our own remote access server, used
              both for technical support and so authorized institution staff can work from home against their
              physical computer at the building).
            </p>
            <p>
              Tailscale, UrBackup, and RustDesk are third-party tools that we integrate and manage within our
              own infrastructure — our value lies in the design, implementation, security, operation, and
              support of the whole set, not in developing that software ourselves.
            </p>
            <p><strong>Disk failure recovery</strong> — this isn't "file backup," it's full workstation disaster recovery:</p>
            <ol class="recovery-steps">
              <li>A computer's disk fails at the institution.</li>
              <li>It's replaced with a new disk.</li>
              <li>The computer is booted from a recovery USB drive.</li>
              <li>The computer connects to our server.</li>
              <li>The latest available backup is restored.</li>
              <li>The workstation is back in operation, with downtime reduced to a minimum.</li>
            </ol>
          </div>
        </article>

      </div>
    </div>
  </section>

  <section class="page-section home-cta dev-cta" style="border-top:1px solid var(--line);">
    <div class="container cta-row">
      <div class="cta-copy reveal">
        <p class="eyebrow">Direct contact</p>
        <h2>Need a custom system, or want to put what you already have in order?</h2>
      </div>
      <div class="actions reveal">
        <a class="button button-primary" href="/en/contact">Tell us about your project</a>
        <a class="button button-secondary" href="https://wa.me/5493512803872" target="_blank" rel="noreferrer">Talk on WhatsApp</a>
      </div>
    </div>
  </section>

  <script>
    // ComuCon screenshot carousel: one image at a time, arrows + dots + autoplay.
    (function () {
      const slider = document.getElementById("comucon-slider");
      const track = document.getElementById("comucon-slide-track");
      const dotsHost = document.getElementById("comucon-dots");
      if (!slider || !track || !dotsHost) return;

      const slides = Array.from(track.querySelectorAll(".comucon-slide"));
      const prevBtn = slider.querySelector(".comucon-nav.prev");
      const nextBtn = slider.querySelector(".comucon-nav.next");
      let index = 0;
      let autoplayId: ReturnType<typeof window.setInterval> | undefined;

      slides.forEach((_, i) => {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "comucon-dot";
        dot.setAttribute("aria-label", `Go to screenshot ${i + 1}`);
        dot.addEventListener("click", () => {
          goTo(i);
          restartAutoplay();
        });
        dotsHost.appendChild(dot);
      });
      const dots = Array.from(dotsHost.querySelectorAll(".comucon-dot"));

      function update() {
        track!.style.transform = `translateX(-${index * 100}%)`;
        dots.forEach((dot, i) => dot.classList.toggle("is-active", i === index));
      }
      function goTo(i: number) {
        index = (i + slides.length) % slides.length;
        update();
      }
      function restartAutoplay() {
        if (autoplayId) window.clearInterval(autoplayId);
        autoplayId = window.setInterval(() => goTo(index + 1), 4000);
      }

      prevBtn?.addEventListener("click", () => {
        goTo(index - 1);
        restartAutoplay();
      });
      nextBtn?.addEventListener("click", () => {
        goTo(index + 1);
        restartAutoplay();
      });
      slider.addEventListener("mouseenter", () => {
        if (autoplayId) window.clearInterval(autoplayId);
      });
      slider.addEventListener("mouseleave", restartAutoplay);

      update();
      restartAutoplay();
    })();
  </script>
</BaseLayout>
