---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { company } from "../../data/site.en";
---

<BaseLayout
  title="Contact | REUTER IT NETWORKS"
  description="Request a quote or schedule an assessment with REUTER IT NETWORKS."
  lang="en"
  altLangHref="/contacto"
>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-bg-grid"></div>
      <div class="hero-bg-orb hero-bg-orb-1"></div>
      <div class="hero-bg-noise"></div>
    </div>
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow">Contact</p>
        <h1>Tell us what you need to solve and we'll continue over WhatsApp.</h1>
        <p class="lead">
          The idea is simple: quickly understand the problem and move forward with a clear conversation.
        </p>
      </div>
      <aside class="hero-panel reveal">
        <div class="panel-stack">
          <span class="panel-chip">Direct channels</span>
          <ul class="hero-list">
            <li><a href={company.whatsappHref} target="_blank" rel="noreferrer">WhatsApp</a></li>
            <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
            <li><a href={`tel:${company.phone}`}>{company.phone}</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="page-section">
    <div class="container contact-grid">
      <article class="contact-card reveal">
        <p class="eyebrow">Quick form</p>
        <h2>This first contact goes straight out through WhatsApp.</h2>

        <form class="contact-form" id="contact-form">
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" placeholder="Your name" required />
          </div>

          <div class="field">
            <label for="organization">Institution or business</label>
            <input id="organization" name="organization" type="text" placeholder="Name of the institution or business" />
          </div>

          <div class="field">
            <label for="locality">Location</label>
            <input id="locality" name="locality" type="text" placeholder="City or town" />
          </div>

          <div class="field">
            <label for="need">Main need</label>
            <textarea
              id="need"
              name="need"
              placeholder="Briefly tell us the problem"
              required
            ></textarea>
          </div>

          <button class="button button-primary" type="submit">Send via WhatsApp</button>
          <p class="status" id="form-status" aria-live="polite"></p>
        </form>
      </article>

      <aside class="contact-card reveal">
        <p class="eyebrow">Home base</p>
        <h2>Córdoba, with the ability to travel depending on the project.</h2>
        <ul class="check-list">
          <li>WhatsApp as the main channel.</li>
          <li>Email for follow-up and documentation.</li>
          <li>On-site visits coordinated according to technical need.</li>
        </ul>
      </aside>
    </div>
  </section>

  <script define:vars={{ whatsappUrl: company.whatsappHref }}>
    const form = document.querySelector("#contact-form");
    const status = document.querySelector("#form-status");

    form?.addEventListener("submit", (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const name = String(formData.get("name") || "").trim();
      const organization = String(formData.get("organization") || "").trim();
      const locality = String(formData.get("locality") || "").trim();
      const need = String(formData.get("need") || "").trim();

      if (!name || !need) {
        if (status) {
          status.textContent = "Please fill in at least your name and your main need.";
        }
        return;
      }

      const lines = [
        "Hi, I'd like to ask about a project.",
        `Name: ${name}`,
        organization ? `Institution or business: ${organization}` : "",
        locality ? `Location: ${locality}` : "",
        `Need: ${need}`
      ].filter(Boolean);

      const href = `${whatsappUrl}?text=${encodeURIComponent(lines.join("\n"))}`;
      window.open(href, "_blank", "noopener,noreferrer");

      if (status) {
        status.textContent = "We've opened WhatsApp with your message ready to send.";
      }
    });
  </script>
</BaseLayout>
