---
import BaseLayout from "../layouts/BaseLayout.astro";
import { company, partnerBrands } from "../data/site";

const slugify = (name: string) => name.toLowerCase().replace(/\s+/g, "-");
// La cinta se repite dos veces para que el marquee haga loop sin cortes.
const ribbonBrands = [...partnerBrands, ...partnerBrands];
---

<BaseLayout
  title="REUTER IT NETWORKS | Soluciones tecnológicas integrales"
  description="Redes, servidores, seguridad, software y automatización para instituciones y empresas en Córdoba."
>
  <section class="hero editorial-hero home-hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-bg-grid"></div>
      <div class="hero-bg-orb hero-bg-orb-1"></div>
      <div class="hero-bg-orb hero-bg-orb-2"></div>
      <div class="hero-bg-noise"></div>
      <div class="hero-bg-particles" id="hero-particles"></div>
    </div>
    <div class="container editorial-grid">
      <div class="editorial-copy reveal">
        <p class="eyebrow">Infraestructura que respalda la operación diaria</p>
        <h1>
          Soluciones tecnológicas
          <span class="gradient-word">integrales</span>
          para instituciones y empresas
        </h1>
        <p class="lead">
          Redes, servidores, cámaras y software integrados en una única solución confiable.
        </p>

        <div class="actions">
          <a class="button button-primary" href="/contacto">Solicitar presupuesto</a>
          <a class="button button-secondary" href={company.whatsappHref} target="_blank" rel="noreferrer">
            Hablar por WhatsApp
          </a>
        </div>

        <ul class="inline-proof">
          <li>Diagnóstico antes que reemplazo.</li>
          <li>Una sola estrategia para varias capas técnicas.</li>
          <li>Criterio real para instituciones y empresas.</li>
        </ul>
      </div>

      <div class="editorial-stage editorial-stage-full reveal">
        <figure class="stage-primary stage-primary-large" data-lightbox>
          <img src="/images/trabajos/home-equipo-rack.png" alt="Equipo técnico de REUTER frente a rack instalado y cableado en sitio." />
          <figcaption>
            <small>Trabajo real en sitio</small>
            <strong>Testeo, revisión y puesta a punto antes de dar por resuelto un problema.</strong>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="brand-ribbon-section" aria-label="Marcas con las que trabajamos">
    <div class="container">
      <div class="brand-ribbon-mask">
        <div class="brand-ribbon-track">
          {ribbonBrands.map((brand) => (
            <img class="brand-ribbon-logo" src={`/images/brands/${slugify(brand)}.png`} alt={brand} loading="lazy" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="page-section home-thesis">
    <div class="container thesis-row">
      <div class="thesis-copy reveal">
        <p class="eyebrow">Casos reales</p>
        <h2>No arrancamos diciendo: "Hay que comprar todo de nuevo", sino diagnosticando el problema.</h2>
      </div>

      <div class="thesis-actions reveal">
        <span class="mono-note">Cuando el trabajo se puede mostrar, la decisión se vuelve más clara.</span>
        <a class="button button-secondary" href="/casos-reales">Ver todos los casos</a>
      </div>
    </div>
  </section>

  <section class="page-section home-cta">
    <div class="container cta-row">
      <div class="cta-copy reveal">
        <p class="eyebrow">Contacto directo</p>
        <h2>Si hoy dependés de demasiados parches, conversemos antes de que el problema crezca.</h2>
      </div>

      <div class="actions reveal">
        <a class="button button-primary" href="/contacto">Pedir diagnóstico</a>
        <a class="button button-secondary" href={company.whatsappHref} target="_blank" rel="noreferrer">
          Hablar ahora por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <script>
    // Partículas decorativas del hero de Home.
    (function () {
      const host = document.getElementById("hero-particles");
      if (!host) return;
      const COUNT = 18;
      for (let i = 0; i < COUNT; i++) {
        const p = document.createElement("span");
        p.style.left = Math.random() * 100 + "%";
        p.style.bottom = -Math.random() * 30 + "%";
        p.style.animationDuration = 10 + Math.random() * 14 + "s";
        p.style.animationDelay = Math.random() * 12 + "s";
        p.style.width = p.style.height = 2 + Math.random() * 3 + "px";
        host.appendChild(p);
      }
    })();
  </script>
</BaseLayout>


