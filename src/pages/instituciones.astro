---
import BaseLayout from "../layouts/BaseLayout.astro";
import { company, services } from "../data/site";

const institutionServices = services.filter((item) =>
  ["Redes y conectividad", "Servidores y backups", "Seguridad y videovigilancia", "Soporte y mantenimiento"].includes(
    item.title
  )
);

const sectors = ["Educacion", "Hoteles", "Clinicas y sanatorios", "Instituciones con operacion intensiva"];
---

<BaseLayout
  title="Instituciones | REUTER IT NETWORKS"
  description="Infraestructura, conectividad, seguridad y soporte para instituciones con alta demanda operativa."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Instituciones</p>
        <h1>Tecnologia para instituciones que no pueden darse el lujo de improvisar.</h1>
        <p class="lead">
          Trabajamos especialmente fuerte en educacion, pero nuestro enfoque sirve para cualquier
          institucion donde conectividad, seguridad y soporte sostienen la operacion diaria.
        </p>
        <div class="tag-row">
          {sectors.map((item) => <span class="tag">{item}</span>)}
        </div>
      </div>

      <aside class="hero-panel">
        <div class="panel-stack">
          <span class="panel-chip">Nuestro enfoque</span>
          <ul class="hero-list">
            <li>Una sola lectura tecnica del problema.</li>
            <li>Infraestructura mas ordenada y mantenible.</li>
            <li>Soporte claro, sin depender de parches.</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Lo que resolvemos</p>
        <h2>Redes, cobertura, seguridad y soporte con una sola estrategia.</h2>
      </div>

      <div class="grid">
        {institutionServices.map((service) => (
          <article class="card">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container hero-panel">
      <div class="section-heading">
        <p class="eyebrow">Siguiente paso</p>
        <h2>Si hoy tu institucion depende de demasiados parches, conviene revisar la base completa.</h2>
      </div>
      <div class="actions">
        <a class="button button-primary" href="/contacto">Pedir evaluacion</a>
        <a class="button button-secondary" href={company.whatsappHref} target="_blank" rel="noreferrer">
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
