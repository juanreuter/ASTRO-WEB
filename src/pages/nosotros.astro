---
import BaseLayout from "../layouts/BaseLayout.astro";
import { company } from "../data/site";

const numbers = [
  { value: "20+ años", label: "de trayectoria tecnológica" },
  {
    value: "128 instituciones",
    label: "experiencia previa brindando asesoramiento tecnológico dentro de una organización educativa"
  },
  { value: "11 instituciones", label: "atendidas actualmente mediante servicios técnicos recurrentes" }
];

// Placeholders preparados para recibir foto/nombre/rol/resumen/especialidades/LinkedIn
// de cada socio. Datos de Juan confirmados; el segundo socio queda a completar.
const team = [
  {
    name: "Juan Reuter",
    role: "Infraestructura, redes y desarrollo",
    photo: "/images/team/juan-reuter.png",
    summary:
      "Trayectoria tecnológica orientada a infraestructura IT, redes y servidores, con formación Cisco Networking Academy (programa CCNA completo). Desarrollo e implementación de sistemas asistidos por IA como parte del método de trabajo.",
    specialties: ["Redes y MikroTik", "Servidores Linux", "Desarrollo de software"],
    linkedin: ""
  },
  {
    name: "",
    role: "",
    photo: "",
    summary: "",
    specialties: [],
    linkedin: ""
  }
];

const sliderItems = [
  {
    image: "/images/trabajos/formosa-pizarra-tactil.jpg",
    alt: "Instalación de pizarra táctil en Formosa.",
    title: "Formosa",
    text: "Pizarras táctiles y proyectores"
  },
  {
    image: "/images/trabajos/bar-redes-y-pantalla.jpg",
    alt: "Tecnología operativa instalada en un bar de Güemes.",
    title: "Güemes, Córdoba",
    text: "Red segmentada y pantalla LED"
  },
  {
    image: "/images/trabajos/villa-cabrera-01.jpeg",
    alt: "Pantalla digital de 75 pulgadas instalada en un colegio de barrio Villa Cabrera.",
    title: "Villa Cabrera",
    text: "Pantalla digital de 75 pulgadas conectada a red"
  },
  {
    image: "/images/trabajos/proyector-instalacion.jpg",
    alt: "Instalación de proyector en aula.",
    title: "Aula multimedia",
    text: "Montaje y ajuste de proyector"
  },
  {
    image: "/images/trabajos/mesa-pruebas-red.jpg",
    alt: "Laboratorio de pruebas con equipos de red y conectividad antes de recomendarlos a clientes.",
    title: "Laboratorio propio",
    text: "Probamos equipos y cuidamos los presupuestos antes de recomendar qué conviene comprar"
  },
  {
    image: "/images/trabajos/coordinacion-transmision.jpg",
    alt: "Coordinación técnica de una transmisión en pandemia.",
    title: "Pandemia",
    text: "Streaming de conferencia por YouTube en época de pandemia"
  },
  {
    image: "/images/trabajos/rack-y-cableado.jpg",
    alt: "Rack y cableado instalados en una escuela.",
    title: "Cosquín",
    text: "Rack, patcheras y distribución de red"
  },
  {
    image: "/images/trabajos/transmision-diplomas.jpg",
    alt: "Operación técnica para acto de egresados transmitido durante pandemia.",
    title: "Instituto superior",
    text: "Transmisión por YouTube para acto de egresados"
  },
  {
    image: "/images/trabajos/capacitacion-laboratorio.jpg",
    alt: "Cierre del curso de CCNA en UTN Córdoba.",
    title: "UTN Córdoba",
    text: "Formación técnica y recorrido profesional"
  },
  {
    image: "/images/trabajos/despenaderos-netbooks.jpg",
    alt: "Preparación de netbooks en una escuela de Despeñaderos un viernes hasta tarde.",
    title: "Despeñaderos",
    text: "Preparando netbooks un viernes hasta tarde"
  }
];
---

<BaseLayout
  title="Nosotros | REUTER IT NETWORKS"
  description="Perfil profesional y enfoque integral de REUTER IT NETWORKS."
>
  <section class="hero editorial-hero about-hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-bg-grid"></div>
      <div class="hero-bg-orb hero-bg-orb-1"></div>
      <div class="hero-bg-noise"></div>
    </div>
    <div class="container editorial-grid about-grid">
      <div class="editorial-copy reveal">
        <p class="eyebrow">Nosotros</p>
        <h1>No vendemos tareas sueltas. Entramos para ordenar el sistema completo.</h1>
        <p class="lead">
          Entendemos la relación entre conectividad, servidores, seguridad, software y automatización,
          y nos hacemos cargo de que todo funcione con el mismo criterio técnico.
        </p>
      </div>

      <div class="approach-lines reveal">
        <div>
          <small>01</small>
          <strong>Diagnóstico claro</strong>
          <span class="approach-node" aria-hidden="true"></span>
        </div>
        <div>
          <small>02</small>
          <strong>Implementación con criterio</strong>
          <span class="approach-node" aria-hidden="true"></span>
        </div>
        <div>
          <small>03</small>
          <strong>Seguimiento real en sitio</strong>
          <span class="approach-node" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container team-editorial">
      <figure class="team-feature team-feature-wide team-feature-flex reveal">
        <img
          src="/images/trabajos/reuter-trabajo-institucional-completo.jpg"
          alt="Trabajo técnico en una institución con varias notebooks en proceso de revisión."
          loading="lazy"
        />

        <figcaption>
          <strong>Trabajo real en instituciones</strong>
          <span>Revisión, preparación y puesta a punto de equipamiento en contexto educativo.</span>
        </figcaption>
      </figure>

      <figure class="team-feature team-feature-tall team-feature-flex reveal">
        <img
          src="/images/trabajos/reuter-en-sitio.jpg"
          alt="Presencia técnica en sitio con herramientas de trabajo."
          loading="lazy"
        />
        <div class="team-pins" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <figcaption>
          <strong>Presencia en campo</strong>
          <span>Diagnóstico, implementación y seguimiento directo donde el trabajo realmente ocurre.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-heading editorial-heading tight reveal">
        <p class="eyebrow">Recorrido real</p>
        <h2>Situaciones distintas, mismo criterio técnico.</h2>
      </div>

      <div class="work-slider editorial-slider reveal" id="work-slider">
        <div class="work-slider-viewport">
          <div class="work-slider-track" id="work-slider-track">
            {sliderItems.map((item) => (
              <article class="work-slide">
                <div class="work-slide-image">
                  <img src={item.image} alt={item.alt} loading="lazy" />
                </div>
                <div class="work-slide-copy">
                  <span>{item.title}</span>
                  <strong>{item.text}</strong>
                </div>
              </article>
            ))}
          </div>
        </div>

        <div class="work-slider-controls">
          <button class="slider-button" type="button" id="work-slider-prev" aria-label="Foto anterior">
            Anterior
          </button>

          <div class="work-slider-dots" id="work-slider-dots"></div>

          <button class="slider-button" type="button" id="work-slider-next" aria-label="Foto siguiente">
            Siguiente
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section-compact">
    <div class="container">
      <div class="coverage-grid reveal">
        {numbers.map((item) => (
          <article class="metric">
            <strong>{item.value}</strong>
            <p>{item.label}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-heading editorial-heading reveal">
        <p class="eyebrow">El equipo</p>
        <h2>Capacidades complementarias dentro de una misma empresa.</h2>
      </div>
      <div class="team-grid reveal">
        {team.map((person) => (
          person.name ? (
            <article class="team-person-card">
              <div class="team-person-photo">
                {person.photo ? <img src={person.photo} alt={person.name} /> : person.name.charAt(0)}
              </div>
              <h3>{person.name}</h3>
              <span class="team-person-role">{person.role}</span>
              <p class="team-person-summary">{person.summary}</p>
              {person.specialties.length > 0 && (
                <div class="team-person-specialties">
                  {person.specialties.map((s) => <span class="tag">{s}</span>)}
                </div>
              )}
              {person.linkedin && <a class="team-person-link" href={person.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>}
            </article>
          ) : (
            <article class="team-person-card" style="justify-content: center; align-items: center; text-align: center; opacity: 0.6;">
              <div class="team-person-photo">?</div>
              <h3>Próximamente</h3>
              <span class="team-person-role">Segundo socio</span>
              <p class="team-person-summary">Espacio preparado para foto, rol, resumen y especialidades.</p>
            </article>
          )
        ))}
      </div>
    </div>
  </section>

  <section class="page-section-compact">
    <div class="container">
      <div class="ai-note reveal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3.8 14.1 8.1l4.7.7-3.4 3.3.8 4.7-4.2-2.2-4.2 2.2.8-4.7-3.4-3.3 4.7-.7L12 3.8Z"></path>
        </svg>
        <p>
          Usamos herramientas modernas de inteligencia artificial como parte de nuestra metodología de trabajo:
          para acelerar desarrollo, scripting, automatización, diagnóstico, documentación y prototipado.
          <strong> IA como herramienta de ingeniería y productividad, siempre bajo supervisión técnica</strong> —
          no reemplaza el criterio, lo acelera.
        </p>
      </div>
    </div>
  </section>

  <section class="page-section about-quote">
    <div class="container open-quote reveal">
      <p class="eyebrow">Detrás de escena</p>
      <h2>"Si en las fotos parezco el que menos trabaja, es solo porque soy el que se acuerda de sacar la foto."</h2>
      <div class="actions">
        <a class="button button-primary" href="/contacto">Hablar del proyecto</a>
        <a class="button button-secondary" href={company.whatsappHref} target="_blank" rel="noreferrer">
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <script define:vars={{ slideCount: sliderItems.length }}>
    const slider = document.querySelector("#work-slider");
    const track = document.querySelector("#work-slider-track");
    const prevButton = document.querySelector("#work-slider-prev");
    const nextButton = document.querySelector("#work-slider-next");
    const dotsHost = document.querySelector("#work-slider-dots");
    const slides = Array.from(document.querySelectorAll("#work-slider-track .work-slide"));

    let currentIndex = 0;
    let autoplayId;
    let pageCount = 0;
    let visibleCount = 1;

    const getVisibleCount = () => {
      if (window.innerWidth <= 720) return 1;
      if (window.innerWidth <= 1050) return 2;
      return 3;
    };

    const renderDots = () => {
      if (!dotsHost) return;
      dotsHost.innerHTML = "";
      for (let index = 0; index < pageCount; index += 1) {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "slider-dot";
        dot.setAttribute("aria-label", `Ir al grupo ${index + 1}`);
        dot.dataset.index = String(index);
        dot.addEventListener("click", () => {
          updateSlider(index);
          restartAutoplay();
        });
        dotsHost.appendChild(dot);
      }
    };

    const syncDots = () => {
      if (!dotsHost) return;
      Array.from(dotsHost.querySelectorAll(".slider-dot")).forEach((dot, dotIndex) => {
        dot.classList.toggle("is-active", dotIndex === currentIndex);
      });
    };

    const updateSlider = (index) => {
      if (!track || !slides.length) return;
      currentIndex = (index + pageCount) % pageCount;
      track.style.transform = `translateX(-${slides[currentIndex].offsetLeft}px)`;
      syncDots();
    };

    const recalculateSlider = () => {
      visibleCount = getVisibleCount();
      pageCount = Math.max(1, slideCount - visibleCount + 1);
      currentIndex = Math.min(currentIndex, pageCount - 1);
      renderDots();
      updateSlider(currentIndex);
    };

    const restartAutoplay = () => {
      if (autoplayId) window.clearInterval(autoplayId);
      autoplayId = window.setInterval(() => updateSlider(currentIndex + 1), 4500);
    };

    prevButton?.addEventListener("click", () => {
      updateSlider(currentIndex - 1);
      restartAutoplay();
    });

    nextButton?.addEventListener("click", () => {
      updateSlider(currentIndex + 1);
      restartAutoplay();
    });

    slider?.addEventListener("mouseenter", () => {
      if (autoplayId) window.clearInterval(autoplayId);
    });

    slider?.addEventListener("mouseleave", () => {
      restartAutoplay();
    });

    window.addEventListener("resize", recalculateSlider);

    recalculateSlider();
    restartAutoplay();
  </script>
</BaseLayout>
