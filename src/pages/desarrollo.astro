---
import BaseLayout from "../layouts/BaseLayout.astro";

// Proyectos con formato "uniforme" (imagen + copy + tags), agrupados por categoría.
// ComuCon e Infraestructura Self-Hosted tienen contenido propio (diagrama de flujo /
// pasos de recuperación) y se escriben aparte, más abajo en el markup.
const platformProjects = [
  {
    id: "miaulanube",
    kicker: "Plataforma educativa (LMS) — multitenant",
    title: "MiAulaNube",
    description:
      "Un aula virtual completa construida desde cero: multiinstitución (cada colegio opera de forma independiente dentro de la misma arquitectura), cursos con unidades y temas, evaluaciones con corrección automática, tareas con entrega y calificación, foros, mensajería interna, notificaciones (push y email) y grabación de clases con pizarra digital. Diseñada desde la experiencia concreta trabajando con instituciones educativas. Hoy está en producción, con un demo público que cualquiera puede probar.",
    link: { href: "https://miaulanube.com", label: "Ver miaulanube.com ↗" },
    tags: ["Next.js", "PostgreSQL", "Prisma", "Docker", "Multitenant"],
    media: { type: "single" as const, src: "/images/desarrollo/mian-hero.png", alt: "Landing de MiAulaNube" }
  }
];

const toolProjects = [
  {
    id: "nettopo",
    kicker: "Descubrimiento y planimetría de redes",
    title: "NetTopo Discovery + NetPlanner",
    lead: "Pasar de una red que nadie conoce completamente a una infraestructura relevada, visible y documentada.",
    descriptionPre:
      "Un motor de descubrimiento automático que releva la topología real de una red — vecinos por LLDP/CDP/MNDP, tablas MAC, ARP y datos directos de routers MikroTik vía RouterOS — y lo vuelca en ",
    descriptionStrong: "NetPlanner",
    descriptionPost:
      ", una herramienta propia de planimetría visual donde cada equipo, puerto y conexión queda documentado y navegable. Pensado para poder salir a relevar una red a campo con una notebook o una Raspberry Pi, y para agilizar el troubleshooting el día que algo falla.",
    tags: ["Python", "SNMP / LLDP / CDP / MNDP", "ARP / tablas MAC", "RouterOS", "Node.js", "Raspberry Pi"],
    media: {
      type: "two-up" as const,
      items: [
        { src: "/images/desarrollo/netplanner-list.png", alt: "Lista de equipos en NetPlanner" },
        { src: "/images/desarrollo/netplanner-topo.png", alt: "Mapa de topología en NetPlanner" }
      ]
    }
  }
];

const internalProjects = [
  {
    id: "facturacion",
    kicker: "Sistema de gestión interna",
    title: "Facturación IT Network",
    description:
      "Sistema propio para administrar clientes, cargar tareas realizadas y generar facturas mensuales, con reparto automático de ingresos entre socios y sincronización en tiempo real contra una base SQL propia. Reemplazó planillas sueltas por un único lugar de trabajo.",
    tags: ["JavaScript", "SQL", "Backend propio"],
    media: { type: "single" as const, src: "/images/desarrollo/facturacion-stats.png", alt: "Panel del sistema de facturación" }
  },
  {
    id: "cefyt",
    kicker: "Gestión académica",
    title: "CEFyT — Instituto Superior",
    description:
      "Sistema de gestión para un instituto de nivel superior: carreras, alumnos, docentes, materias, calendario académico con horarios por carrera y año, e historial de inscripciones — todo en un panel institucional propio, a medida de cómo trabaja el instituto.",
    tags: ["PHP", "MySQL"],
    media: { type: "single" as const, src: "/images/desarrollo/cefyt-stats.png", alt: "Panel de administración de CEFyT" },
    reverse: true
  }
];
---

<BaseLayout
  title="Software y Plataformas | REUTER IT NETWORKS"
  description="Plataformas propias, herramientas de red, sistemas de gestión a medida e infraestructura self-hosted: el software real detrás de la infraestructura que implementamos."
  ogImage="/images/desarrollo/mian-hero.png"
  bodyClass="dev-scope"
>
  <style is:global>
    /* ============================================================
       Sección "Software y Plataformas" — paleta propia (MiAulaNube)
       Se mantiene el shell/tipografía del sitio; el acento cambia
       de teal a azul/naranja solo dentro de .dev-scope.
       ============================================================ */
    .dev-scope {
      --accent: #3b82f6;
      --accent-2: #f97316;
      --accent-deep: #1e40af;
      --accent-soft: rgba(59, 130, 246, 0.12);
      --accent-2-soft: rgba(249, 115, 22, 0.14);
    }
    .dev-hero { padding: clamp(3rem, 6vw, 5rem) 0 clamp(2rem, 4vw, 3rem); }
    .dev-hero .hero-bg-orb-1 { background: radial-gradient(circle, rgba(59, 130, 246, 0.4), transparent 70%); }
    .dev-hero .hero-bg-orb-2 { background: radial-gradient(circle, rgba(249, 115, 22, 0.28), transparent 70%); }
    .dev-hero .hero-bg-grid {
      background-image:
        linear-gradient(rgba(59, 130, 246, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(59, 130, 246, 0.05) 1px, transparent 1px);
    }
    .dev-stack-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.75rem; }

    /* ---- capability strip ---- */
    .dev-capabilities {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      border-top: 1px solid var(--line);
      border-left: 1px solid var(--line);
    }
    .dev-cap {
      padding: 2rem 1.5rem;
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }
    .dev-cap-num {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--accent);
      letter-spacing: 0.08em;
      margin-bottom: 0.9rem;
      display: block;
    }
    .dev-cap h3 { margin-bottom: 0.5rem; }
    .dev-cap p { font-size: 0.92rem; }
    @media (max-width: 900px) { .dev-capabilities { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 560px) { .dev-capabilities { grid-template-columns: 1fr; } }

    /* ---- project rows ---- */
    .dev-projects { display: flex; flex-direction: column; gap: clamp(3rem, 5vw, 5rem); }
    .dev-project { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }
    .dev-project.rev .dev-project-media { order: 2; }
    .dev-project.rev .dev-project-copy { order: 1; }
    .dev-project-media {
      position: relative; border-radius: 0.85rem; overflow: hidden;
      border: 1px solid rgba(59, 130, 246, 0.25);
      box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
      background: #0a0a0a;
    }
    .dev-project-media img { width: 100%; display: block; }
    .dev-project-media.two-up { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; background: rgba(59, 130, 246, 0.15); }
    .dev-project-media.two-up img { height: 260px; object-fit: cover; }
    /* ---- carrusel de capturas de ComuCon ---- */
    .dev-project-media.comucon-slider {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0a0f16;
      padding: 2.5rem 1rem 3.25rem;
    }
    .comucon-slide-track { display: flex; width: 100%; transition: transform 0.45s ease; }
    .comucon-slide { flex: 0 0 100%; display: flex; justify-content: center; }
    .comucon-slide img {
      width: 100%;
      max-width: 300px;
      display: block;
      border-radius: 1.1rem;
      border: 1px solid rgba(59, 130, 246, 0.3);
      box-shadow: 0 25px 45px -18px rgba(0, 0, 0, 0.65);
    }
    .comucon-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 2.4rem;
      height: 2.4rem;
      border-radius: 50%;
      border: 1px solid rgba(59, 130, 246, 0.35);
      background: rgba(10, 15, 22, 0.8);
      color: #fff;
      font-size: 1.3rem;
      line-height: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    .comucon-nav:hover { border-color: var(--accent); color: var(--accent); }
    .comucon-nav.prev { left: 0.75rem; }
    .comucon-nav.next { right: 0.75rem; }
    .comucon-dots { position: absolute; bottom: 1.1rem; left: 50%; transform: translateX(-50%); display: flex; gap: 0.45rem; }
    .comucon-dot { width: 6px; height: 6px; padding: 0; border: none; border-radius: 50%; background: rgba(255, 255, 255, 0.28); cursor: pointer; }
    .comucon-dot.is-active { background: var(--accent); }
    .dev-project-kicker { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-2); margin-bottom: 0.75rem; display: block; }
    .dev-project-copy h3 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(1.5rem, 2.2vw, 2rem); margin-bottom: 0.9rem; letter-spacing: -0.01em; }
    .dev-project-copy p { margin-bottom: 1.1rem; }
    .dev-project-lead { color: var(--text); font-style: italic; font-family: var(--font-serif); font-size: 1.05rem !important; }
    .dev-project-copy .tag-row { margin-top: 1.25rem; }
    .dev-project-copy .tag:hover { color: var(--accent); border-color: var(--accent); }
    .dev-project-link { display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--font-mono); font-size: 0.82rem; color: var(--accent); border-bottom: 1px solid transparent; }
    .dev-project-link:hover { border-bottom-color: var(--accent); }
    @media (max-width: 820px) {
      .dev-project { grid-template-columns: 1fr; }
      .dev-project.rev .dev-project-media { order: 1; }
      .dev-project.rev .dev-project-copy { order: 2; }
    }

    .dev-cta { border-color: rgba(59, 130, 246, 0.3) !important; }
    .dev-cta .button-primary { background: var(--accent-2); border-color: var(--accent-2); box-shadow: 4px 4px 0 rgba(249, 115, 22, 0.25); }
    .dev-cta .button-primary:hover { background: #ea6a0a; border-color: #ea6a0a; }
  </style>

  <section class="hero dev-hero editorial-hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-bg-grid"></div>
      <div class="hero-bg-orb hero-bg-orb-1"></div>
      <div class="hero-bg-orb hero-bg-orb-2"></div>
      <div class="hero-bg-noise"></div>
    </div>
    <div class="container">
      <div class="editorial-copy reveal" style="max-width:44rem;">
        <p class="eyebrow">Software y Plataformas</p>
        <h1>Software a medida, con la <span class="gradient-word">infraestructura real</span> detrás</h1>
        <p class="lead">
          No solo instalamos redes: diseñamos, programamos y desplegamos los sistemas que corren sobre ellas
          — y los mantenemos funcionando en producción, todos los días.
        </p>
        <div class="dev-stack-row">
          <span class="tag">Next.js / React</span>
          <span class="tag">Node.js</span>
          <span class="tag">PostgreSQL / MySQL</span>
          <span class="tag">Docker</span>
          <span class="tag">Python</span>
          <span class="tag">PHP</span>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section-compact">
    <div class="container">
      <div class="dev-capabilities reveal">
        <div class="dev-cap">
          <span class="dev-cap-num">01</span>
          <h3>Plataformas a medida</h3>
          <p>LMS, sistemas de gestión y portales institucionales, construidos y desplegados de punta a punta — no solo la pantalla, también el backend y la base de datos.</p>
        </div>
        <div class="dev-cap">
          <span class="dev-cap-num">02</span>
          <h3>Infraestructura y despliegue</h3>
          <p>Servidores Linux, contenedores Docker, reverse proxy, bases de datos y backups — el mismo servidor real, no un demo aislado.</p>
        </div>
        <div class="dev-cap">
          <span class="dev-cap-num">03</span>
          <h3>DNS, correo y seguridad</h3>
          <p>Dominios, DNS, entrega de correo transaccional, certificados y accesos — la parte invisible que hace que todo lo demás funcione.</p>
        </div>
        <div class="dev-cap">
          <span class="dev-cap-num">04</span>
          <h3>Automatización</h3>
          <p>Scripts, integraciones y herramientas internas a medida para sacar de encima tareas repetitivas.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-heading editorial-heading reveal">
        <p class="eyebrow">Proyectos</p>
        <h2>Plataformas propias, herramientas técnicas e infraestructura</h2>
      </div>

      <div class="dev-projects">

        <div class="dev-category-heading reveal">
          <span>01</span>
          <h3>Plataformas</h3>
        </div>

        {platformProjects.map((project) => (
          <article class="dev-project reveal" id={project.id}>
            <div class="dev-project-media">
              <img src={project.media.src} alt={project.media.alt} />
            </div>
            <div class="dev-project-copy">
              <span class="dev-project-kicker">{project.kicker}</span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <a class="dev-project-link" href={project.link.href} target="_blank" rel="noreferrer">{project.link.label}</a>
              <div class="tag-row">
                {project.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </article>
        ))}

        <!-- ComuCon: contenido propio (capturas reales de la app, no encaja en la plantilla genérica) -->
        <article class="dev-project rev reveal" id="comucon">
          <div class="dev-project-media comucon-slider" id="comucon-slider">
            <div class="comucon-slide-track" id="comucon-slide-track">
              <div class="comucon-slide"><img src="/images/desarrollo/comucon-1.jpg" alt="Pantalla de inicio de sesión de la app ComuCon" loading="lazy" /></div>
              <div class="comucon-slide"><img src="/images/desarrollo/comucon-2.jpg" alt="Listado de comunicados y autorizaciones enviados en ComuCon, con estado de firma de los padres" loading="lazy" /></div>
              <div class="comucon-slide"><img src="/images/desarrollo/comucon-3.jpg" alt="Detalle de una autorización con los padres que todavía no firmaron" loading="lazy" /></div>
              <div class="comucon-slide"><img src="/images/desarrollo/comucon-4.jpg" alt="Selector para crear una nueva autorización o comunicado en ComuCon" loading="lazy" /></div>
            </div>
            <button class="comucon-nav prev" type="button" aria-label="Captura anterior">‹</button>
            <button class="comucon-nav next" type="button" aria-label="Captura siguiente">›</button>
            <div class="comucon-dots" id="comucon-dots"></div>
          </div>
          <div class="dev-project-copy">
            <span class="dev-project-kicker">Comunicación institucional — Comunidad Conectada</span>
            <h3>ComuCon</h3>
            <p>
              Sistema de comunicación institucional jerárquica y en tiempo real, orientado principalmente a
              instituciones educativas. Reemplaza procesos tradicionales como el cuaderno físico de comunicados
              por una comunicación digital directa, trazable y organizada entre la institución y las familias.
            </p>
            <div class="flow-diagram" role="img" aria-label="Flujo: Institución envía Comunicación o Autorización a la Familia, que responde en tiempo real y queda registrado en la Institución.">
              <div class="flow-step">
                <span class="flow-step-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5h16"></path><path d="M8 5.5h8"></path><path d="M8 13.5h8"></path><path d="M6.5 17.5h11"></path><path d="M5.5 4h13a1.5 1.5 0 0 1 1.5 1.5v9A1.5 1.5 0 0 1 18.5 16h-13A1.5 1.5 0 0 1 4 14.5v-9A1.5 1.5 0 0 1 5.5 4Z"></path></svg>
                </span>
                <span>Institución</span>
              </div>
              <span class="flow-arrow" aria-hidden="true">→</span>
              <div class="flow-step">
                <span class="flow-step-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6.5 4.5 10 8 13.5"></path><path d="M16 6.5 19.5 10 16 13.5"></path></svg>
                </span>
                <span>Comunicación / Autorización</span>
              </div>
              <span class="flow-arrow" aria-hidden="true">→</span>
              <div class="flow-step">
                <span class="flow-step-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.2"></circle><path d="M5.5 19.5c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"></path></svg>
                </span>
                <span>Familia</span>
              </div>
              <span class="flow-arrow" aria-hidden="true">→</span>
              <div class="flow-step">
                <span class="flow-step-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.6 11.8 11.3 13.5 14.7 10.1"></path><path d="M12 3.5 18.5 6v5.2c0 4.1-2.6 7.8-6.5 9.3-3.9-1.5-6.5-5.2-6.5-9.3V6L12 3.5Z"></path></svg>
                </span>
                <span>Respuesta registrada</span>
              </div>
            </div>
            <p style="margin-top: 1.25rem;"><strong>Comunicaciones:</strong> mensajes informativos que no requieren acción del receptor; la institución puede saber si el mensaje fue visto.</p>
            <p><strong>Autorizaciones:</strong> mensajes que requieren una decisión del padre o tutor (autorizar / no autorizar). La respuesta llega en tiempo real a la institución, queda registrada y existe trazabilidad del consentimiento.</p>
            <div class="comucon-modes">
              <span class="tag">App Android</span>
              <span class="tag">PWA</span>
              <span class="tag">Instalable en PC</span>
              <span class="tag">Instalable en iPhone/iOS (PWA)</span>
            </div>
          </div>
        </article>

        <div class="dev-category-heading reveal">
          <span>02</span>
          <h3>Herramientas técnicas</h3>
        </div>

        {toolProjects.map((project) => (
          <article class="dev-project reveal" id={project.id}>
            <div class="dev-project-media two-up">
              {project.media.items.map((item) => <img src={item.src} alt={item.alt} />)}
            </div>
            <div class="dev-project-copy">
              <span class="dev-project-kicker">{project.kicker}</span>
              <h3>{project.title}</h3>
              <p class="dev-project-lead">{project.lead}</p>
              <p>{project.descriptionPre}<strong>{project.descriptionStrong}</strong>{project.descriptionPost}</p>
              <div class="tag-row">
                {project.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </article>
        ))}

        <div class="dev-category-heading reveal">
          <span>03</span>
          <h3>Sistemas internos y a medida</h3>
        </div>

        {internalProjects.map((project) => (
          <article class:list={["dev-project", "reveal", project.reverse && "rev"]} id={project.id}>
            <div class="dev-project-media">
              <img src={project.media.src} alt={project.media.alt} />
            </div>
            <div class="dev-project-copy">
              <span class="dev-project-kicker">{project.kicker}</span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="tag-row">
                {project.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </article>
        ))}

        <div class="dev-category-heading reveal">
          <span>04</span>
          <h3>Infraestructura</h3>
        </div>

        <!-- Self-hosted: contenido propio (pasos de recuperación, no encaja en la plantilla genérica) -->
        <article class="dev-project reveal" id="self-hosted">
          <div class="dev-project-media">
            <img
              src="/images/desarrollo/self-hosted-arquitectura.png"
              alt="Diagrama de la arquitectura self-hosted de backup, recuperación ante desastres y acceso remoto: instituciones conectadas por Tailscale VPN a un servidor propio con UrBackup y RustDesk self-hosted, con acceso remoto para personal administrativo y soporte técnico."
              loading="lazy"
            />
          </div>
          <div class="dev-project-copy">
            <span class="dev-project-kicker">Backup, disaster recovery y acceso remoto</span>
            <h3>Infraestructura Self-Hosted</h3>
            <p>
              Combinamos <strong>Tailscale</strong> (red privada que conecta de forma segura los equipos de
              distintas instituciones con nuestro servidor), <strong>UrBackup</strong> (servidor central de
              backups que administramos nosotros, con clientes en cada equipo remoto haciendo copias automáticas
              a través de esa red privada) y <strong>RustDesk self-hosted</strong> (servidor propio de acceso
              remoto, usado tanto para soporte técnico como para que personal autorizado de una institución
              trabaje desde su casa contra su computadora física en el edificio).
            </p>
            <p>
              Tailscale, UrBackup y RustDesk son herramientas de terceros que integramos y administramos dentro
              de infraestructura propia — nuestro valor está en el diseño, la implementación, la seguridad,
              la operación y el soporte de todo el conjunto, no en el desarrollo de ese software.
            </p>
            <p><strong>Recuperación ante falla de disco</strong> — no es "backup de archivos", es disaster recovery del puesto completo:</p>
            <ol class="recovery-steps">
              <li>Falla el disco de una computadora de la institución.</li>
              <li>Se reemplaza por un disco nuevo.</li>
              <li>Se inicia el equipo con un pendrive/USB de recuperación.</li>
              <li>El equipo se conecta a nuestro servidor.</li>
              <li>Se recupera la última copia disponible.</li>
              <li>El puesto vuelve a estar operativo, con el tiempo de inactividad reducido al mínimo.</li>
            </ol>
          </div>
        </article>

      </div>
    </div>
  </section>

  <section class="page-section home-cta dev-cta" style="border-top:1px solid var(--line);">
    <div class="container cta-row">
      <div class="cta-copy reveal">
        <p class="eyebrow">Contacto directo</p>
        <h2>¿Necesitás un sistema a medida, o poner en orden lo que ya tenés funcionando?</h2>
      </div>
      <div class="actions reveal">
        <a class="button button-primary" href="/contacto">Contar el proyecto</a>
        <a class="button button-secondary" href="https://wa.me/5493512803872" target="_blank" rel="noreferrer">Hablar por WhatsApp</a>
      </div>
    </div>
  </section>

  <script>
    // Carrusel de capturas de ComuCon: una imagen a la vez, flechas + dots + autoplay.
    (function () {
      const slider = document.getElementById("comucon-slider");
      const track = document.getElementById("comucon-slide-track");
      const dotsHost = document.getElementById("comucon-dots");
      if (!slider || !track || !dotsHost) return;

      const slides = Array.from(track.querySelectorAll(".comucon-slide"));
      const prevBtn = slider.querySelector(".comucon-nav.prev");
      const nextBtn = slider.querySelector(".comucon-nav.next");
      let index = 0;
      let autoplayId;

      slides.forEach((_, i) => {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "comucon-dot";
        dot.setAttribute("aria-label", `Ir a la captura ${i + 1}`);
        dot.addEventListener("click", () => {
          goTo(i);
          restartAutoplay();
        });
        dotsHost.appendChild(dot);
      });
      const dots = Array.from(dotsHost.querySelectorAll(".comucon-dot"));

      function update() {
        track.style.transform = `translateX(-${index * 100}%)`;
        dots.forEach((dot, i) => dot.classList.toggle("is-active", i === index));
      }
      function goTo(i) {
        index = (i + slides.length) % slides.length;
        update();
      }
      function restartAutoplay() {
        if (autoplayId) window.clearInterval(autoplayId);
        autoplayId = window.setInterval(() => goTo(index + 1), 4000);
      }

      prevBtn?.addEventListener("click", () => {
        goTo(index - 1);
        restartAutoplay();
      });
      nextBtn?.addEventListener("click", () => {
        goTo(index + 1);
        restartAutoplay();
      });
      slider.addEventListener("mouseenter", () => {
        if (autoplayId) window.clearInterval(autoplayId);
      });
      slider.addEventListener("mouseleave", restartAutoplay);

      update();
      restartAutoplay();
    })();
  </script>
</BaseLayout>
